@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_LoginLayout.cshtml"; // Use custom layout
}

<div class="login-right">
    <div class="login-header">
        <div style="text-align: center; margin-bottom: 20px;">
            <img src="~/images/logo.png" alt="SAFS Logo"/>
        </div>
        <h2>Smart Assessment Feedback System</h2>
        <p>Please login to your account to continue</p>
    </div>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-group">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@ais.ac.nz" />
            <label asp-for="Input.Email" class="form-label">Username</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
            <label asp-for="Input.Password" class="form-label">Password</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-options">
            <label class="remember-me">
                <input type="checkbox" name="remember">
                <span>Remember me</span>
            </label>
        </div>

        <div>
            <button id="login-submit" type="submit" class="login-button">Log in</button>
        </div>
        <p>
            <a asp-page="./ForgotPassword">Forgot your password?</a>
        </p>
    </form>

    <!-- Footer -->
    <br />
    <br />
    <footer>
        <strong>Copyright &copy; 2025 <a href="#">Smart Assessment Feedback System</a>.</strong>
        All rights reserved.
        <div class="float-right d-none d-sm-inline-block">
            <b>Version</b> 1.0.0
        </div>
    </footer>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
