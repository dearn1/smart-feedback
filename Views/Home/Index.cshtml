@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Welcome to Smart Assessment Feedback System</h3>
            </div>
            <div class="card-body">
                <p>This is your dashboard where you can manage assessments and view feedback.</p>
                
                @if (User.IsInRole("Admin"))
                {
                    <div class="alert alert-info">
                        <h5><i class="icon fas fa-info"></i> Admin Panel</h5>
                        You have administrator privileges. You can manage users and system settings.
                    </div>
                }
                
                @if (User.IsInRole("Lecturer"))
                {
                    <div class="alert alert-success">
                        <h5><i class="icon fas fa-check"></i> Lecturer Dashboard</h5>
                        You can create and manage assessments for your courses.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    @* Lecturer Courses Section *@
    @if (ViewBag.LecturerCourses != null && ((List<smart_feedback.Models.ViewModels.CourseRolesViewModel>)ViewBag.LecturerCourses).Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chalkboard-teacher"></i> My Admin Courses
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Course Code</th>
                                        <th>Course Name</th>
                                        <th>Year</th>
                                        <th>Trimester</th>
                                        <th>Programme</th>
                                        <th>Lecturer</th>
                                        <th>Moderator</th>
                                        <th style="min-width: 400px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in (List<smart_feedback.Models.ViewModels.CourseRolesViewModel>)ViewBag.LecturerCourses)
                                    {
                                        <tr>
                                            <td>@course.CourseCode</td>
                                            <td>@course.CourseName</td>
                                            <td>@course.Year</td>
                                            <td>@course.Trimester</td>
                                            <td>@course.Programme</td>
                                            <td>@course.LecturerFullName</td>
                                            <td>@course.ModeratorFullName</td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <a asp-controller="Rubrics" asp-action="AssessmentManagement" 
                                                       asp-route-courseId="@course.CourseRolesId"
                                                       asp-route-role="Admin"
                                                       class="btn btn-outline-primary btn-sm" 
                                                       title="Manage Assessment Rubrics">
                                                        <i class="fas fa-list me-1"></i> Rubrics
                                                    </a>
                                                    <a asp-controller="CourseStudents" asp-action="Manage"
                                                       asp-route-courseId="@course.CourseRolesId"
                                                       asp-route-role="Admin"
                                                       class="btn btn-outline-info btn-sm"
                                                       title="Manage Students">
                                                        <i class="fas fa-users me-1"></i> Students
                                                    </a>
                                                    <a asp-controller="StudentAssessments" asp-action="Index"
                                                       asp-route-courseId="@course.CourseRolesId"
                                                       asp-route-role="Admin"
                                                       class="btn btn-outline-success btn-sm"
                                                       title="Manage Marking">
                                                        <i class="fas fa-clipboard-check me-1"></i> Marking
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (User.IsInRole("Lecturer"))
{
    @* Lecturer Courses Section *@
    @if (ViewBag.LecturerCourses != null && ((List<smart_feedback.Models.ViewModels.CourseRolesViewModel>)ViewBag.LecturerCourses).Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chalkboard-teacher"></i> My Lecturer Courses
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Course Code</th>
                                        <th>Course Name</th>
                                        <th>Year</th>
                                        <th>Trimester</th>
                                        <th>Programme</th>
                                        <th>Moderator</th>
                                        <th style="min-width: 400px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in (List<smart_feedback.Models.ViewModels.CourseRolesViewModel>)ViewBag.LecturerCourses)
                                    {
                                        <tr class="@(course.HasFinalReview ? "table-warning" : "")">
                                            <td>@course.CourseCode</td>
                                            <td>
                                                @course.CourseName
                                                @if (course.HasFinalReview)
                                                {
                                                    <span class="badge bg-warning text-dark ms-2">
                                                        <i class="fas fa-exclamation-circle"></i> @course.FinalReviewCount Final Review
                                                    </span>
                                                }
                                            </td>
                                            <td>@course.Year</td>
                                            <td>@course.Trimester</td>
                                            <td>@course.Programme</td>
                                            <td>@course.ModeratorFullName</td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <a asp-controller="Rubrics" asp-action="AssessmentManagement"
                                                       asp-route-courseId="@course.CourseRolesId"
                                                       asp-route-role="Lecturer"
                                                       class="btn btn-outline-primary btn-sm"
                                                       title="Manage Assessment Rubrics">
                                                        <i class="fas fa-list me-1"></i> Rubrics
                                                    </a>
                                                    <a asp-controller="CourseStudents" asp-action="Manage"
                                                       asp-route-courseId="@course.CourseRolesId"
                                                       asp-route-role="Lecturer"
                                                       class="btn btn-outline-info btn-sm"
                                                       title="Manage Students">
                                                        <i class="fas fa-users me-1"></i> Students
                                                    </a>
                                                    <a asp-controller="StudentAssessments" asp-action="Index"
                                                       asp-route-courseId="@course.CourseRolesId"
                                                       asp-route-role="Lecturer"
                                                       class="@(course.HasFinalReview ? "btn btn-warning btn-sm" : "btn btn-outline-success btn-sm")"
                                                       title="Manage Marking">
                                                        <i class="fas fa-clipboard-check me-1"></i> 
                                                        @if (course.HasFinalReview)
                                                        {
                                                            <span class="fw-bold">Marking <span class="badge bg-dark">@course.FinalReviewCount</span></span>
                                                        }
                                                        else
                                                        {
                                                            <span>Marking</span>
                                                        }
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Moderator Courses Section *@
    @if (ViewBag.ModeratorCourses != null && ((List<smart_feedback.Models.ViewModels.CourseRolesViewModel>)ViewBag.ModeratorCourses).Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-shield"></i> My Moderator Courses
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Course Code</th>
                                        <th>Course Name</th>
                                        <th>Year</th>
                                        <th>Trimester</th>
                                        <th>Programme</th>
                                        <th>Lecturer</th>
                                        <th style="min-width: 350px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in (List<smart_feedback.Models.ViewModels.CourseRolesViewModel>)ViewBag.ModeratorCourses)
                                    {
                                        <tr class="@(course.HasModeration ? "table-info" : "")">
                                            <td>@course.CourseCode</td>
                                            <td>
                                                @course.CourseName
                                                @if (course.HasModeration)
                                                {
                                                    <span class="badge bg-info text-dark ms-2">
                                                        <i class="fas fa-exclamation-circle"></i> @course.ModerationCount Moderation
                                                    </span>
                                                }
                                            </td>
                                            <td>@course.Year</td>
                                            <td>@course.Trimester</td>
                                            <td>@course.Programme</td>
                                            <td>@course.LecturerFullName</td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <a asp-controller="Rubrics" asp-action="AssessmentManagement"
                                                       asp-route-courseId="@course.CourseRolesId"
                                                       asp-route-role="Moderator"
                                                       class="btn btn-outline-primary btn-sm"
                                                       title="Manage Assessment Rubrics">
                                                        <i class="fas fa-list me-1"></i> Rubrics
                                                    </a>
                                                    <a asp-controller="StudentAssessments" asp-action="Index"
                                                       asp-route-courseId="@course.CourseRolesId"
                                                       asp-route-role="Moderator"
                                                       class="@(course.HasModeration ? "btn btn-info btn-sm" : "btn btn-outline-warning btn-sm")"
                                                       title="View Marking">
                                                        <i class="fas fa-clipboard-check me-1"></i> 
                                                        @if (course.HasModeration)
                                                        {
                                                            <span class="fw-bold">Review Marking <span class="badge bg-dark">@course.ModerationCount</span></span>
                                                        }
                                                        else
                                                        {
                                                            <span>Review Marking</span>
                                                        }
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<style>
    /* Highlight effect for rows with pending actions */
    .table-warning {
        background-color: #fff3cd !important;
        border-left: 4px solid #ffc107;
    }
    
    .table-info {
        background-color: #d1ecf1 !important;
        border-left: 4px solid #17a2b8;
    }
    
    /* Pulse animation for action buttons */
    .btn-warning.btn-sm,
    .btn-info.btn-sm {
        animation: pulse-shadow 2s infinite;
    }
    
    @@keyframes pulse-shadow {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7);
        }
        50% {
            box-shadow: 0 0 0 10px rgba(255, 193, 7, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
        }
    }
    
    .table-info .btn-info.btn-sm {
        animation: pulse-shadow-info 2s infinite;
    }
    
    @@keyframes pulse-shadow-info {
        0% {
            box-shadow: 0 0 0 0 rgba(23, 162, 184, 0.7);
        }
        50% {
            box-shadow: 0 0 0 10px rgba(23, 162, 184, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(23, 162, 184, 0);
        }
    }
    
    .badge.bg-warning {
        color: #000 !important;
    }
    
    .badge.bg-info {
        color: #000 !important;
    }
</style>