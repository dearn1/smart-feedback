@model smart_feedback.Models.ViewModels.StudentAssessmentViewModel
@{
    ViewData["Title"] = "Student Assessments";
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-clipboard-check"></i> Student Assessments - @Model.CourseCode @Model.CourseName (@Model.Trimester @Model.Year)
                </h3>
                <div class="card-tools">
                    @if (Model.Role == "Lecturer" || Model.Role == "Admin")
                    {
                        <a asp-action="Create" asp-route-courseId="@Model.CourseRolesId" asp-route-role="@Model.Role" 
                           class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Create New Assessment
                        </a>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (Model.Assessments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Assessment Name</th>
                                    <th>Rubric</th>
                                    <th>Total Marks</th>
                                    <th>Marking Progress</th>
                                    <th>Status</th>
                                    <th>Lecturer</th>
                                    <th>Moderator</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assessment in Model.Assessments)
                                {
                                    var markedCount = Model.AssessmentMarkedStudents.ContainsKey(assessment.AssessmentId) 
                                        ? Model.AssessmentMarkedStudents[assessment.AssessmentId].Count 
                                        : 0;
                                    var totalStudents = Model.Students.Count;
                                    var progressPercentage = Model.AssessmentMarkingProgress.ContainsKey(assessment.AssessmentId) 
                                        ? Model.AssessmentMarkingProgress[assessment.AssessmentId] 
                                        : 0;
                                    var progressColor = progressPercentage == 100 ? "success" : (progressPercentage > 0 ? "warning" : "danger");

                                    <tr>
                                        <td>
                                            <strong>@assessment.AssessmentName</strong>
                                            @if (progressPercentage == 100)
                                            {
                                                <span class="badge badge-success ml-2">
                                                    <i class="fas fa-check-circle"></i> Complete
                                                </span>
                                            }
                                            else if (progressPercentage > 0)
                                            {
                                                <span class="badge badge-warning ml-2">
                                                    <i class="fas fa-clock"></i> In Progress
                                                </span>
                                            }
                                        </td>
                                        <td>@assessment.Rubric?.RubricName</td>
                                        <td>@assessment.Rubric?.TotalMarks</td>
                                        <td>
                                            <div class="progress" style="height: 25px;">
                                                <div class="progress-bar progress-bar-striped bg-@progressColor" 
                                                     role="progressbar" 
                                                     style="width: @progressPercentage%"
                                                     aria-valuenow="@progressPercentage" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                    @progressPercentage%
                                                </div>
                                            </div>
                                            <small class="text-muted">@markedCount / @totalStudents students marked</small>
                                        </td>
                                        <td>@assessment.Status</td>
                                        <td>@ViewBag.LecturerFullName</td>
                                        <td>@ViewBag.ModeratorFullName</td>                                        
                                        <td>
                                            <div class="btn-group" role="group">
                                                @if (Model.Role == "Lecturer" && (assessment.Status == "Marking" || assessment.Status == "ReMark" || assessment.Status == "FinalReview" || assessment.Status == "Published"))
                                                {
                                                    <a asp-action="Mark" asp-route-id="@assessment.AssessmentId" 
                                                       asp-route-courseId="@Model.CourseRolesId" asp-route-role="@Model.Role"
                                                       class="btn btn-success btn-sm"
                                                       title="Mark Students">
                                                        <i class="fas fa-edit"></i> Mark
                                                    </a>
                                                }
                                                @if (Model.Role == "Moderator" && (assessment.Status == "Moderation" || assessment.Status == "Published"))
                                                {
                                                    <a asp-action="Mark" asp-route-id="@assessment.AssessmentId"
                                                       asp-route-courseId="@Model.CourseRolesId" asp-route-role="@Model.Role"
                                                       class="btn btn-success btn-sm"
                                                       title="Mark Students">
                                                        <i class="fas fa-edit"></i> Mark
                                                    </a>
                                                }
                                                <button type="button" class="btn btn-info btn-sm" 
                                                        data-toggle="modal" 
                                                        data-target="#studentListModal_@assessment.AssessmentId"
                                                        title="View Students">
                                                    <i class="fas fa-users"></i> Students
                                                </button>
                                                @if (assessment.Status == "Published" && (Model.Role == "Lecturer" || User.IsInRole("Admin")))
                                                {
                                                    <a asp-action="GenerateFeedback" 
                                                       asp-route-id="@assessment.AssessmentId" 
                                                       asp-route-courseId="@Model.CourseRolesId" 
                                                       asp-route-role="@Model.Role" 
                                                       class="btn btn-secondary btn-sm" 
                                                       title="View Batch Reports">
                                                        <i class="fas fa-chart-bar"></i> Batch Reports
                                                    </a>
                                                }
                                                @if (Model.Role == "Lecturer" || User.IsInRole("Admin"))
                                                {
                                                    <button type="button" 
                                                            class="btn btn-danger btn-sm" 
                                                            data-toggle="modal" 
                                                            data-target="#deleteModal_@assessment.AssessmentId"
                                                            title="Delete Assessment">
                                                        <i class="fas fa-trash-alt"></i> Delete
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        No assessments found for this course. 
                        @if (Model.Role == "Lecturer")
                        {
                            <a asp-action="Create" asp-route-courseId="@Model.CourseRolesId" asp-route-role="@Model.Role" 
                               class="btn btn-sm btn-primary ml-2">
                                Create your first assessment
                            </a>
                        }
                    </div>
                }

                @if (!Model.AvailableRubrics.Any() && Model.Role == "Lecturer")
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        No rubrics available for this course. You need to create or upload a rubric before creating assessments.
                        <a asp-controller="Rubrics" asp-action="Index" asp-route-courseId="@Model.CourseRolesId" asp-route-role="@Model.Role" 
                           class="btn btn-sm btn-warning ml-2">
                            Manage Rubrics
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Student List Modals for Each Assessment -->
@foreach (var assessment in Model.Assessments)
{
    var markedStudentIds = Model.AssessmentMarkedStudents.ContainsKey(assessment.AssessmentId) 
        ? Model.AssessmentMarkedStudents[assessment.AssessmentId] 
        : new List<int>();

    <div class="modal fade" id="studentListModal_@assessment.AssessmentId" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-users"></i> Student Marking Status - @assessment.AssessmentName
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Student ID</th>
                                    <th>Student Name</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.Students.OrderBy(s => s.StudentId))
                                {
                                    var isMarked = markedStudentIds.Contains(student.Id);
                                    var rowClass = isMarked ? "table-success" : "";
                                    var studentIndex = Model.Students.IndexOf(student);

                                    <tr class="@rowClass">
                                        <td>
                                            <strong>@student.StudentId</strong>
                                        </td>
                                        <td>
                                            @student.Name
                                            @if (isMarked)
                                            {
                                                <i class="fas fa-check-circle text-success ml-2" title="Marked"></i>
                                            }
                                        </td>
                                        <td>@student.Email</td>
                                        <td>
                                            @if (isMarked)
                                            {
                                                <span class="badge badge-success">
                                                    <i class="fas fa-check"></i> Marked
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">
                                                    <i class="fas fa-hourglass-half"></i> Not Marked
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="mr-auto">
                        <small class="text-muted">
                            <i class="fas fa-info-circle"></i> 
                            <span class="text-success font-weight-bold">Green rows</span> indicate students who have been marked
                        </small>
                    </div>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modals for Each Assessment -->
@foreach (var assessment in Model.Assessments)
{
    var markedCount = Model.AssessmentMarkedStudents.ContainsKey(assessment.AssessmentId) 
        ? Model.AssessmentMarkedStudents[assessment.AssessmentId].Count 
        : 0;

    <div class="modal fade" id="deleteModal_@assessment.AssessmentId" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle"></i> Delete Assessment
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <strong>Warning!</strong> This action cannot be undone.
                    </div>
                    <p>Are you sure you want to delete the assessment <strong>"@assessment.AssessmentName"</strong>?</p>
                    
                    @if (markedCount > 0)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-circle"></i>
                            <strong>Important:</strong> This assessment has <strong>@markedCount student(s)</strong> with recorded scores.
                            All student scores and marking data will be permanently deleted.
                        </div>
                    }
                    
                    <p class="mb-0">
                        <strong>This will delete:</strong>
                    </p>
                    <ul>
                        <li>Assessment record</li>
                        @if (markedCount > 0)
                        {
                            <li>All student scores (@markedCount student(s))</li>
                            <li>All marking comments</li>
                        }
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <form asp-action="Delete" 
                          asp-route-id="@assessment.AssessmentId" 
                          asp-route-courseId="@Model.CourseRolesId" 
                          asp-route-role="@Model.Role" 
                          method="post" 
                          style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-alt"></i> Yes, Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-users"></i> Students Overview
                </h3>
            </div>
            <div class="card-body">
                <p><strong>Total Students:</strong> @Model.Students.Count</p>
                @if (Model.Students.Any())
                {
                    <ul class="list-unstyled">
                        @foreach (var student in Model.Students.Take(5))
                        {
                            <li>
                                <small class="text-muted">
                                    • @student.StudentId - @student.Name
                                </small>
                            </li>
                        }
                        @if (Model.Students.Count > 5)
                        {
                            <li><small class="text-muted">... and @(Model.Students.Count - 5) more</small></li>
                        }
                    </ul>
                }
                else
                {
                    <div class="alert alert-warning">
                        No students found. You may need to add students to the system first.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-list-alt"></i> Available Rubrics
                </h3>
            </div>
            <div class="card-body">
                <p><strong>Total Rubrics:</strong> @Model.AvailableRubrics.Count</p>
                @if (Model.AvailableRubrics.Any())
                {
                    <ul class="list-unstyled">
                        @foreach (var rubric in Model.AvailableRubrics.Take(3))
                        {
                            <li><small class="text-muted">• @rubric.RubricName (@rubric.TotalMarks marks)</small></li>
                        }
                        @if (Model.AvailableRubrics.Count > 3)
                        {
                            <li><small class="text-muted">... and @(Model.AvailableRubrics.Count - 3) more</small></li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Tooltip initialization
            $('[data-toggle="tooltip"]').tooltip();
            
            // Confirm deletion with double-check
            $('form[action*="Delete"]').on('submit', function(e) {
                var form = $(this);
                var assessmentName = form.closest('.modal-content').find('strong').first().text();
                
                // Optional: Add extra confirmation for assessments with scores
                if (form.closest('.modal-body').find('.alert-warning').length > 0) {
                    if (!confirm('This assessment has student scores. Are you absolutely sure you want to delete it?')) {
                        e.preventDefault();
                        return false;
                    }
                }
            });
            
            // Show success/error messages with animation
            @if (TempData["SuccessMessage"] != null)
            {
                @:toastr.success('@TempData["SuccessMessage"]');
            }
            
            @if (TempData["ErrorMessage"] != null)
            {
                @:toastr.error('@TempData["ErrorMessage"]');
            }
        });
    </script>
}

<style>
    .table-success {
        background-color: #d4edda !important;
    }
    
    .progress {
        border: 1px solid #dee2e6;
    }
    
    .modal-lg {
        max-width: 900px;
    }
    
    .badge {
        font-size: 0.85em;
        padding: 0.35em 0.65em;
    }
    
    .btn-group .btn {
        margin-right: 2px;
    }
    
    .btn-group .btn:last-child {
        margin-right: 0;
    }
    
    /* Delete button specific styling */
    .btn-danger.btn-sm {
        transition: all 0.3s ease;
    }
    
    .btn-danger.btn-sm:hover {
        transform: scale(1.05);
        box-shadow: 0 2px 5px rgba(220, 53, 69, 0.4);
    }
</style>
