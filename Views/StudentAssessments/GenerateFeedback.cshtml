        @foreach (var feedback in Model.AllStudentFeedbacks)
        {
            <div class="page-break">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-graduate"></i> Feedback Report - @feedback.Student.Name
                        </h3>
                    </div>
                    <div class="card-body">
                        <!-- Student Information -->
                        <div class="row mb-4">
