                                                    </span>
                                                }
                                                else if (feedback.Percentage >= 50)
                                                {
                                                    <span class="badge badge-warning badge-lg">
                                                        <i class="fas fa-chart-line mr-1"></i> Satisfactory Performance
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-info badge-lg">
                                                        <i class="fas fa-hand-holding-heart mr-1"></i> Room for Growth
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>  <!-- Close printAllContent div -->
}  <!-- <-- Add this closing brace to properly close the if block -->

@section Scripts {
    <script>
        function navigateToStudent(index) {
            var url = '@Url.Action("GenerateFeedback", "StudentAssessments")?id=@Model.Assessment.AssessmentId&courseId=@Model.CourseRolesId&role=@Model.Role&studentIndex=' + index;
            window.location.href = url;
        }

        function printAllStudents() {
            // Get the hidden content
            var printContent = document.getElementById('printAllContent').innerHTML;
            var originalContent = document.body.innerHTML;

            // Replace body with print content
            document.body.innerHTML = printContent;
            
            // Print
            window.print();
            
            // Restore original content
            document.body.innerHTML = originalContent;
            
            // Reload to restore functionality
            location.reload();
        }

        @if (!Model.IsBatchMode)
        {
            <text>
            $(document).ready(function() {
                $('[data-toggle="tooltip"]').tooltip();
            });
            </text>
        }
    </script>
}

