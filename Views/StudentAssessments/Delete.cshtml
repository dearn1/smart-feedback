@model smart_feedback.Models.Assessment
@{
    ViewData["Title"] = "Delete Assessment";
    var courseId = ViewBag.CourseId as string;
    var role = ViewBag.Role as string;
    var hasScores = (bool)(ViewBag.HasScores ?? false);
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title">
                    <i class="fas fa-exclamation-triangle"></i> Delete Assessment
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-danger">
                    <h4><i class="fas fa-exclamation-circle"></i> Warning!</h4>
                    <p>Are you sure you want to delete this assessment?</p>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Assessment Name:</dt>
                    <dd class="col-sm-8"><strong>@Model.AssessmentName</strong></dd>

                    <dt class="col-sm-4">Rubric:</dt>
                    <dd class="col-sm-8">@Model.Rubric?.RubricName</dd>

                    <dt class="col-sm-4">Total Marks:</dt>
                    <dd class="col-sm-8">@Model.Rubric?.TotalMarks</dd>

                    <dt class="col-sm-4">Course Code:</dt>
                    <dd class="col-sm-8">@Model.CourseCode</dd>

                    <dt class="col-sm-4">Term:</dt>
                    <dd class="col-sm-8">@Model.TermName</dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>

                @if (hasScores)
                {
                    <div class="alert alert-warning">
                        <h5><i class="fas fa-info-circle"></i> Important Notice</h5>
                        <p>This assessment contains student scores. Deleting this assessment will also delete:</p>
                        <ul>
                            <li>All student scores for this assessment</li>
                            <li>All marking data associated with this assessment</li>
                        </ul>
                        <p class="mb-0"><strong>This action cannot be undone!</strong></p>
                    </div>
                }

                <form asp-action="Delete" asp-route-id="@Model.AssessmentId"
                      asp-route-courseId="@courseId" asp-route-role="@role" method="post">
                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="fas fa-trash-alt"></i> Yes, Delete Assessment
                        </button>
                        <a asp-action="Index" asp-route-courseId="@courseId" asp-route-role="@role"
                           class="btn btn-secondary btn-lg">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>