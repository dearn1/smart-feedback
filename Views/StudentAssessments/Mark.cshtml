                            toastr.success(response.message);
                        } else {
                            alert('Success: ' + response.message);
                        }
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message || 'Failed to save moderator comments');
                        } else {
                            alert('Error: ' + (response.message || 'Failed to save moderator comments'));
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', xhr.responseText);
                    var errorMessage = 'An error occurred while saving moderator comments.';

                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        errorMessage = 'Server error: ' + xhr.responseText;
                    }

                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorMessage);
                    } else {
                        alert('Error: ' + errorMessage);
                    }
                },
                complete: function() {
                    $('#saveModeratorComments').prop('disabled', false).html('<i class="fas fa-save"></i> Save Moderator Comments');
                }
