@model smart_feedback.Models.ViewModels.AssessmentMarkingViewModel

@{
    ViewData["Title"] = "Mark Students";
    var currentStudent = Model.Students.FirstOrDefault();
    var hasNext = Model.CurrentStudentIndex < Model.TotalStudents - 1;
    var hasPrevious = Model.CurrentStudentIndex > 0;
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-clipboard-check"></i> Mark Students - @Model.Assessment.AssessmentName
                </h3>
            </div>
            <div class="card-body">
                @if (currentStudent != null && Model.RubricCriterias.Any())
                {
                    <!-- Student Navigation -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-4">
                                            <h4 class="mb-0">
                                                <i class="fas fa-user"></i> @currentStudent.Name
                                            </h4>
                                            <p class="mb-0">ID: @currentStudent.StudentId</p>
                                        </div>
                                        <div class="col-md-4 text-center">
                                            <h5 class="mb-0">Student @(Model.CurrentStudentIndex + 1) of @Model.TotalStudents</h5>
                                            <div class="progress mt-2" style="height: 10px;">
                                                <div class="progress-bar bg-success" role="progressbar"
                                                     style="width: @(((double)(Model.CurrentStudentIndex + 1) / Model.TotalStudents) * 100)%"
                                                     aria-valuenow="@(Model.CurrentStudentIndex + 1)"
                                                     aria-valuemin="0"
                                                     aria-valuemax="@Model.TotalStudents"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 text-right">
                                            <div class="btn-group" role="group">
                                                @if (hasPrevious)
                                                {
                                                    <a href="@Url.Action("Mark", new {
                                                        id = Model.Assessment.AssessmentId,
                                                        courseId = Model.CourseRolesId,
                                                        role = Model.Role,
                                                        studentIndex = Model.CurrentStudentIndex - 1 })"
                                                       class="btn btn-outline-light">
                                                        <i class="fas fa-chevron-left"></i> Previous
                                                    </a>
                                                }

                                                <!-- Student Selection Dropdown -->
                                                <div class="dropdown">
                                                    <button class="btn btn-outline-light dropdown-toggle" type="button"
                                                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                        <i class="fas fa-list"></i> Go To
                                                    </button>
                                                    <div class="dropdown-menu">
                                                        @for (int i = 0; i < Model.AllStudents.Count; i++)
                                                        {
                                                            <a class="dropdown-item @(i == Model.CurrentStudentIndex ? "active" : "")"
                                                               href="@Url.Action("Mark", new {
                                                                   id = Model.Assessment.AssessmentId,
                                                                   courseId = Model.CourseRolesId,
                                                                   role = Model.Role,
                                                                   studentIndex = i })">
                                                                @(i + 1). @Model.AllStudents[i].Name
                                                            </a>
                                                        }
                                                    </div>
                                                </div>

                                                @if (hasNext)
                                                {
                                                    <a href="@Url.Action("Mark", new {
                                                        id = Model.Assessment.AssessmentId,
                                                        courseId = Model.CourseRolesId,
                                                        role = Model.Role,
                                                        studentIndex = Model.CurrentStudentIndex + 1 })"
                                                       class="btn btn-outline-light">
                                                        Next <i class="fas fa-chevron-right"></i>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Task-Based Assessment Tables -->
                    @foreach (var task in Model.RubricTasks.OrderBy(t => t.TaskTitle))
                    {
                        var taskCriterias = Model.RubricCriterias.Where(rc => rc.RubricTaskId == task.RubricTaskId).OrderBy(c => c.CriterionTitle);
                        var taskMaxScore = taskCriterias.Sum(tc => tc.Weight * tc.MaxScore / 100.0);

                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header bg-info text-white">
                                        <h5 class="mb-0">
                                            <i class="fas fa-tasks"></i> @task.TaskTitle
                                            <span class="badge badge-light ml-2">@task.MaxMarks marks</span>
                                        </h5>
                                        <small class="text-white-50">@task.TaskDescription</small>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-hover mb-0">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th style="width: 20%">Criteria</th>
                                                        <th style="width: 5%" class="text-center">Weight</th>
                                                        @* Dynamic Score Title Headers *@
                                                        @{
                                                            var firstCriteria = taskCriterias.FirstOrDefault();
                                                            if (firstCriteria != null)
                                                            {
                                                                var maxScore = Model.CriteriaScores
                                                                .Where(cs => cs.RubricCriteriaId == firstCriteria.RubricCriteriaId)
                                                                .Max(cs => cs.CriterionScore);
																var widthPerScore = 55 / (maxScore + 1); // Distribute 55% width among score columns

                                                                for (int i = maxScore; i >= 0; i--)
                                                                {
                                                                    var scoreTitle = Model.CriteriaScores
                                                                    .FirstOrDefault(cs => cs.RubricCriteriaId == firstCriteria.RubricCriteriaId && cs.CriterionScore == i)?.ScoreTitle;

                                                                    <th style="width: 10%" class="text-center">
                                                                        <div class="score-header">
                                                                            <strong>@i</strong>
                                                                            @if (!string.IsNullOrEmpty(scoreTitle))
                                                                            {
                                                                                <br>

                                                                                <small class="text-muted">@scoreTitle</small>
                                                                            }
                                                                        </div>
                                                                    </th>
                                                                }
                                                            }
                                                        }
                                                        <th style="width: 5%" class="text-center">Weighted Score</th>
                                                        <th style="width: 15%" class="text-center">Lecturer Comments</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var criteria in taskCriterias)
                                                    {
                                                        var maxScore = Model.CriteriaScores
                                                        .Where(cs => cs.RubricCriteriaId == criteria.RubricCriteriaId)
                                                        .Max(cs => cs.CriterionScore);
                                                        var currentScore = Model.StudentScores.ContainsKey(currentStudent.Id) &&
                                                        Model.StudentScores[currentStudent.Id].ContainsKey(criteria.RubricCriteriaId)
                                                        ? Model.StudentScores[currentStudent.Id][criteria.RubricCriteriaId].Score : 0;
                                                        var customComment = Model.StudentScores.ContainsKey(currentStudent.Id) &&
                                                        Model.StudentScores[currentStudent.Id].ContainsKey(criteria.RubricCriteriaId)
                                                        ? Model.StudentScores[currentStudent.Id][criteria.RubricCriteriaId].CustomComment : "";

                                                        <tr data-criteria="@criteria.RubricCriteriaId"
                                                            data-student="@currentStudent.Id"
                                                            data-task="@task.RubricTaskId"
                                                            data-weight="@criteria.Weight"
                                                            data-max-score="@maxScore">

                                                            <!-- Criteria Name -->
                                                            <td class="align-middle">
                                                                <strong>@criteria.CriterionTitle</strong>
                                                            </td>

                                                            <!-- Weight -->
                                                            <td class="text-center align-middle">
                                                                <span class="badge badge-info">@criteria.Weight%</span>
                                                            </td>

                                                            <!-- Score Radio Buttons - Individual Columns -->
                                                            @for (int i = maxScore; i >= 0; i--)
                                                            {
                                                                var scoreDescription = Model.CriteriaScores
                                                                .FirstOrDefault(cs => cs.RubricCriteriaId == criteria.RubricCriteriaId && cs.CriterionScore == i)?.ScoreDescription;
                                                                var scoreTitle = Model.CriteriaScores
                                                                .FirstOrDefault(cs => cs.RubricCriteriaId == criteria.RubricCriteriaId && cs.CriterionScore == i)?.ScoreTitle;

                                                                <td class="text-center align-top">
                                                                    <input type="radio" class="btn-check score-radio"
                                                                           name="score_@(currentStudent.Id)_@(criteria.RubricCriteriaId)"
                                                                           id="score_@(currentStudent.Id)_@(criteria.RubricCriteriaId)_@i"
                                                                           value="@i"
                                                                           checked="@(currentScore > 0 && currentScore == i)"
                                                                           data-student="@currentStudent.Id"
                                                                           data-criteria="@criteria.RubricCriteriaId"
                                                                           data-task="@task.RubricTaskId"
                                                                           data-weight="@criteria.Weight"
                                                                           data-max-score="@maxScore">
                                                                    <label class="btn btn-outline-primary btn-sm w-100"
                                                                           for="score_@(currentStudent.Id)_@(criteria.RubricCriteriaId)_@i"
                                                                           title="@scoreTitle: @scoreDescription">
                                                                        <i class="fas fa-check"></i>
                                                                    </label>
                                                                    @if (!string.IsNullOrEmpty(scoreDescription))
                                                                    {
                                                                        <div class="mt-1">
                                                                            <small class="text-muted">@scoreDescription</small>
                                                                        </div>
                                                                    }
                                                                </td>
                                                            }

                                                            <!-- Weighted Score -->
                                                            <td class="text-center align-middle bg-light">
                                                                <h5 class="mb-0">
                                                                    <span class="badge badge-success weighted-score"
                                                                          data-student="@currentStudent.Id"
                                                                          data-criteria="@criteria.RubricCriteriaId">
                                                                        -
                                                                    </span>
                                                                </h5>
                                                                <small class="text-muted">of @((criteria.Weight * maxScore / 100.0).ToString("F2"))</small>
                                                            </td>

                                                            <!-- Comments -->
                                                            <td>
                                                                <textarea name="comment_@(currentStudent.Id)_@(criteria.RubricCriteriaId)"
                                                                          class="form-control"
                                                                          rows="2"
                                                                          placeholder="Additional comments">@customComment</textarea>
                                                            </td>
                                                        </tr>
                                                    }

                                                </tbody>
                                                <tfoot class="table-info">
                                                    <tr>
                                                        <th colspan="@(2 + (firstCriteria != null ? Model.CriteriaScores.Where(cs => cs.RubricCriteriaId == firstCriteria.RubricCriteriaId).Max(cs => cs.CriterionScore) + 1 : 3))" class="text-right">
                                                            <strong>@task.TaskTitle Total:</strong>
                                                        </th>
                                                        <th class="text-center">
                                                            <h5 class="mb-0">
                                                                <span class="badge badge-info task-subtotal"
                                                                      data-student="@currentStudent.Id"
                                                                      data-task="@task.RubricTaskId">-</span>
                                                            </h5>
                                                            <small class="text-muted">
                                                                / @taskMaxScore.ToString("F2")
                                                            </small>
                                                            <br>
                                                            <small class="task-subtotal-percentage text-success"
                                                                   data-student="@currentStudent.Id"
                                                                   data-task="@task.RubricTaskId">-%</small>
                                                        </th>
                                                        <th></th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Task Summary Cards -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-chart-bar"></i> Task Score Summary
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        @foreach (var task in Model.RubricTasks.OrderBy(t => t.TaskTitle))
                                        {
                                            var taskCriterias = Model.RubricCriterias.Where(rc => rc.RubricTaskId == task.RubricTaskId);
                                            var taskMaxScore = taskCriterias.Sum(tc => tc.Weight * tc.MaxScore / 100.0);

                                            <div class="col-md-4 mb-3">
                                                <div class="card task-summary-card border-info"
                                                    data-task="@task.RubricTaskId"
                                                    data-max-marks="@task.MaxMarks">
                                                    <div class="card-body text-center">
                                                        <h6 class="card-title text-info">@task.TaskTitle</h6>
                                                        <h3 class="text-primary">
                                                            <span class="task-total-score" data-student="@currentStudent.Id" data-task="@task.RubricTaskId">-</span>
                                                        </h3>
                                                        <p class="text-muted mb-1">out of @task.MaxMarks</p>
                                                        <div class="progress" style="height: 8px;">
                                                            <div class="progress-bar bg-info task-progress"
                                                                 data-student="@currentStudent.Id"
                                                                 data-task="@task.RubricTaskId"
                                                                 data-max="@taskMaxScore"
                                                                 role="progressbar"
                                                                 style="width: 0%"
                                                                 aria-valuenow="0"
                                                                 aria-valuemin="0"
                                                                 aria-valuemax="@taskMaxScore"></div>
                                                        </div>
                                                        <small class="task-percentage text-success" data-student="@currentStudent.Id" data-task="@task.RubricTaskId">Marks 0% of 100%</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Overall Summary -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">
                                        <i class="fas fa-calculator"></i> Overall Assessment Summary
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col-md-6">
                                            <h3 class="text-primary">
                                                <span class="student-weighted-total" data-student="@currentStudent.Id">-</span>
                                            </h3>
                                            <p class="text-muted">Total Score</p>
                                            <small class="text-muted">
                                                out of @Model.RubricTasks.Sum(t => t.MaxMarks).ToString("F2")
                                            </small>
                                        </div>
                                        <div class="col-md-6">
                                            <h3 class="text-success">
                                                <span class="student-percentage" data-student="@currentStudent.Id">-</span>
                                            </h3>
                                            <p class="text-muted">Overall Score</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="row">
                        <div class="col-md-12 text-center">
                            <button type="button" class="btn btn-success btn-lg" id="saveScores">
                                <i class="fas fa-save"></i> Save Scores
                            </button>
                            <button type="button" class="btn btn-info btn-lg generate-feedback"
                                    data-student="@currentStudent.Id">
                                <i class="fas fa-comment-alt"></i> Generate Feedback
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        No students or rubric criteria found. Please ensure students are added to the system and the rubric has criteria defined.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Add anti-forgery token for AJAX requests
            $('body').append('<input type="hidden" name="__RequestVerificationToken" value="' + $('[name="__RequestVerificationToken"]').val() + '">');

            // Calculate totals when scores change
            $('.score-radio').on('change', function() {
                var studentId = $(this).data('student');
                console.log('Score changed for student:', studentId); // Debug log
                calculateStudentTotal(studentId);
                calculateTaskTotals(studentId);
            });

            // Initial calculation on page load
            @if (currentStudent != null)
            {
                @:calculateStudentTotal(@currentStudent.Id);
                @:calculateTaskTotals(@currentStudent.Id);
            }

            // Save scores
            $('#saveScores').on('click', function() {
                saveScores();
            });

            // Generate feedback
            $('.generate-feedback').on('click', function() {
                var studentId = $(this).data('student');
                var url = '@Url.Action("GenerateFeedback", "StudentAssessments")' +
                         '?id=@Model.Assessment.AssessmentId&studentId=' + studentId +
                         '&courseId=@Model.CourseRolesId&role=@Model.Role';
                window.open(url, '_blank');
            });

            // Keyboard navigation
            $(document).keydown(function(e) {
                if (e.ctrlKey || e.metaKey) {
                    switch(e.which) {
                        case 37: // Left arrow
        @if (hasPrevious)
        {
            @:window.location.href = '@Url.Action("Mark", new
                {
                    id = Model.Assessment.AssessmentId,
                    courseId = Model.CourseRolesId,
                    role = Model.Role,
                    studentIndex = Model.CurrentStudentIndex - 1
                })';
        }
                            e.preventDefault();
                            break;
                        case 39: // Right arrow
        @if (hasNext)
        {
            @:window.location.href = '@Url.Action("Mark", new
                {
                    id = Model.Assessment.AssessmentId,
                    courseId = Model.CourseRolesId,
                    role = Model.Role,
                    studentIndex = Model.CurrentStudentIndex + 1
                })';
        }
                            e.preventDefault();
                            break;
                        case 83: // S key
                            saveScores();
                            e.preventDefault();
                            break;
                    }
                }
            });
        });

    function calculateStudentTotal(studentId) {
            var overallWeightedTotal = 0;
            var overallRawTotal = 0;
            var totalMaxMarks = 0;
            var totalMaxWeighted = 0;
            var percentageAll = 0;
            var taskMaxMarksFromHTML = 0;

            console.log('Calculating total for student:', studentId);

            // Get all unique task IDs
            var taskIds = [];
            $('tr[data-student="' + studentId + '"][data-task]').each(function() {
                var taskId = $(this).data('task');
                if (taskId && taskIds.indexOf(taskId) === -1) {
                    taskIds.push(taskId);
                }
            });

            // Calculate totals for each task
            taskIds.forEach(function(taskId) {
                var taskWeightedTotal = 0;
                var taskRawTotal = 0;
                var taskMaxRaw = 0;
                var taskMaxWeighted = 0;
                var taskMaxScore = 0;
                

                // Get task max marks from the badge
                var taskMaxMarks = parseInt($('.task-summary-card[data-task="' + taskId + '"]').data('max-marks')) || 0;
        
                taskMaxMarksFromHTML = 0;
                $('.task-summary-card[data-task="' + taskId + '"] .badge-light').each(function() {
                    var badgeText = $(this).text();
                    var matches = badgeText.match(/(\d+)/);
                    if (matches) {
                        taskMaxMarksFromHTML = parseInt(matches[1]);
                    }
                });

                // Process each criteria in this task
                $('tr[data-student="' + studentId + '"][data-task="' + taskId + '"]').each(function() {
                    var criteriaRow = $(this);
                    var criteriaId = criteriaRow.data('criteria');
                    var weight = parseFloat(criteriaRow.data('weight')) || 0;
                    var maxScore = parseInt(criteriaRow.data('max-score')) || 0;
                    taskMaxScore = parseInt(criteriaRow.data('max-score')) || 0;

                    taskMaxWeighted += (maxScore * weight) / 100;
                    taskMaxRaw += maxScore;

                    var checkedRadio = criteriaRow.find('.score-radio:checked');
                    if (checkedRadio.length > 0) {
                        var score = parseInt(checkedRadio.val()) || 0;
                        var weightedScore = (score * weight) / 100;
                        taskWeightedTotal += weightedScore;
                        taskRawTotal += score;

                        $('.weighted-score[data-student="' + studentId + '"][data-criteria="' + criteriaId + '"]')
                            .text(weightedScore.toFixed(2));
                            
                    } else {
                        $('.weighted-score[data-student="' + studentId + '"][data-criteria="' + criteriaId + '"]')
                            .text('-');
                    }
                });

                overallWeightedTotal += taskWeightedTotal;
                overallRawTotal += taskRawTotal;
                totalMaxMarks += taskMaxMarksFromHTML || taskMaxRaw;
                totalMaxWeighted += taskMaxWeighted;
                percentageAll += (taskWeightedTotal / taskMaxScore * taskMaxMarks);
            });

            
            console.log('Overall Totals:', {
                overallWeightedTotal,
                overallRawTotal,
                totalMaxMarks,
                totalMaxWeighted,
                percentageAll
            });

            // Use weighted totals for display (aligns with task calculations)
            $('.student-weighted-total[data-student="' + studentId + '"]').text(percentageAll.toFixed(2));

            // Calculate percentage based on weighted scores
            $('.student-percentage[data-student="' + studentId + '"]').text(percentageAll.toFixed(2));
        }



        function calculateTaskTotals(studentId) {
            // Get all unique task IDs
            var taskIds = [];
            $('tr[data-student="' + studentId + '"][data-task]').each(function() {
                var taskId = $(this).data('task');
                if (taskId && taskIds.indexOf(taskId) === -1) {
                    taskIds.push(taskId);
                }
            });

            console.log('Task IDs found:', taskIds);

            // Calculate totals for each task
            taskIds.forEach(function(taskId) {
                var taskWeightedTotal = 0;
                var taskMaxWeightedTotal = 0;
                var taskRawTotal = 0;
                var taskMaxRawTotal = 0;
                var taskMarks = 0;
                var taskMaxScore = 0;
                var taskMaxMarks = parseInt($('.task-summary-card[data-task="' + taskId + '"]').data('max-marks')) || 0;

                $('tr[data-student="' + studentId + '"][data-task="' + taskId + '"]').each(function() {
                    var weight = parseFloat($(this).data('weight')) || 0;
                    var maxScore = parseInt($(this).data('max-score')) || 0;

                    // Weighted calculations
                    taskMaxWeightedTotal += (maxScore * weight) / 100;
                    taskMaxScore = maxScore;

                    var checkedRadio = $(this).find('.score-radio:checked');
                    if (checkedRadio.length > 0) {
                        var score = parseInt(checkedRadio.val()) || 0;
                        taskWeightedTotal += (score * weight) / 100;                        
                        taskRawTotal += score;
                    }

                    // Raw score totals for progress calculation
                    taskMaxRawTotal += maxScore;
                });

                taskMarks = taskWeightedTotal * taskMaxMarks / taskMaxScore;

                console.log('Task', taskId, 'totals:', { taskWeightedTotal, taskMaxWeightedTotal, taskRawTotal, taskMaxRawTotal, taskMarks, taskMaxMarks });

                // Update displays
                $('.task-total-score[data-student="' + studentId + '"][data-task="' + taskId + '"]')
                    .text(taskMarks.toFixed(2));
                $('.task-subtotal[data-student="' + studentId + '"][data-task="' + taskId + '"]')
                    .text(taskWeightedTotal.toFixed(2));

                // Percentage based on weighted scores
                var taskPercentage = taskMaxWeightedTotal > 0 ? (taskWeightedTotal / taskMaxWeightedTotal * 100) : 0;
                $('.task-percentage[data-student="' + studentId + '"][data-task="' + taskId + '"]')
                    .text(taskPercentage.toFixed(2) + '% of 100%');
                $('.task-subtotal-percentage[data-student="' + studentId + '"][data-task="' + taskId + '"]')
                    .text(taskPercentage.toFixed(2) + '%');

                // Progress bar based on raw scores to align with MaxMarks
                var progressBar = $('.task-progress[data-student="' + studentId + '"][data-task="' + taskId + '"]');
                var rawPercentage = taskMaxRawTotal > 0 ? (taskRawTotal / taskMaxRawTotal * 100) : 0;

                progressBar.css('width', rawPercentage.toFixed(2) + '%')
                          .attr('aria-valuenow', taskRawTotal)
                          .attr('aria-valuemax', taskMaxRawTotal);
            });
        }




        function saveScores() {
            var scores = {};
            var comments = {};

            // Collect scores
            $('.score-radio:checked').each(function() {
                var name = $(this).attr('name');
                var value = $(this).val();
                scores[name] = value;
            });

            // Collect comments
            $('textarea[name^="comment_"]').each(function() {
                var name = $(this).attr('name');
                var value = $(this).val();
                comments[name] = value;
            });

            $.ajax({
                url: '@Url.Action("SaveScores", "StudentAssessments")',
                type: 'POST',
                data: {
                    assessmentId: @Model.Assessment.AssessmentId,
                    courseId: '@Model.CourseRolesId',
                    role: '@Model.Role',
                    scores: scores,
                    comments: comments,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        // Show success message
                        if (typeof toastr !== 'undefined') {
                            toastr.success(response.message);
                        } else {
                            alert('Success: ' + response.message);
                        }
                    } else {
                        // Show error message
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message || 'Failed to save scores');
                        } else {
                            alert('Error: ' + (response.message || 'Failed to save scores'));
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', xhr.responseText);
                    var errorMessage = 'An error occurred while saving scores.';

                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        errorMessage = 'Server error: ' + xhr.responseText;
                    }

                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorMessage);
                    } else {
                        alert('Error: ' + errorMessage);
                    }
                },
                complete: function() {
                    // Restore button state
                    $('#saveScores').prop('disabled', false).html('<i class="fas fa-save"></i> Save Scores');
                }
            });
        }

        // Debug function - remove in production
        function debugScoreData() {
            console.log('Score radio buttons:', $('.score-radio').length);
            console.log('Score selections:', $('.score-selection').length);
            
            $('.score-selection').each(function() {
