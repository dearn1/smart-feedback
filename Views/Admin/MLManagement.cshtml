@{
    ViewData["Title"] = "ML Model Management";
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-brain"></i> Machine Learning Model Management
                </h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Feedback Generation Model</h5>
                        <p>Status: <span class="badge badge-success">Active</span></p>
                        <button class="btn btn-primary" onclick="trainModel('feedback')">
                            <i class="fas fa-play"></i> Train Feedback Model
                        </button>
                    </div>
                    <div class="col-md-6">
                        <h5>Sentiment Analysis Model</h5>
                        <p>Status: <span class="badge badge-success">Active</span></p>
                        <button class="btn btn-primary" onclick="trainModel('sentiment')">
                            <i class="fas fa-play"></i> Train Sentiment Model
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function trainModel(type) {
            $.ajax({
                url: '@Url.Action("TrainMLModel", "StudentAssessments")',
                type: 'POST',
                data: { modelType: type, __RequestVerificationToken: $('[name="__RequestVerificationToken"]').val() },
                success: function(response) {
                    toastr.success('Model training initiated successfully');
                },
                error: function() {
                    toastr.error('Failed to initiate model training');
                }
            });
        }
    </script>
}
