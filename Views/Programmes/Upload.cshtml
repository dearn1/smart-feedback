@{
    ViewData["Title"] = "Upload Programmes from Excel";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-file-excel text-success me-2"></i>
            @ViewData["Title"]
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to List
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Upload Form Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-upload me-2"></i>
                        Upload Excel File
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="fas fa-file-excel me-1"></i>
                                Select Excel File
                            </label>
                            <input type="file" 
                                   name="excelFile" 
                                   class="form-control" 
                                   accept=".xlsx,.xls" 
                                   required />
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Supported formats: .xlsx, .xls (Maximum size: 5MB)
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-upload me-1"></i>
                                Upload Programmes
                            </button>
                            <a asp-action="DownloadTemplate" class="btn btn-outline-primary">
                                <i class="fas fa-download me-1"></i>
                                Download Template
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Instructions Card -->
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Instructions
                    </h5>
                </div>
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Excel File Format:</h6>
                    <ol class="mb-4">
                        <li class="mb-2">Download the template file by clicking "Download Template"</li>
                        <li class="mb-2">Column A must contain the <strong>Programme Name</strong></li>
                        <li class="mb-2">Programme names must be <strong>unique</strong></li>
                        <li class="mb-2">Maximum length: <strong>200 characters</strong></li>
                        <li class="mb-2">Remove the sample rows before uploading</li>
                    </ol>

                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Note:</strong> Duplicate programme names will be automatically skipped during upload.
                    </div>
                </div>
            </div>

            <!-- Example Card -->
            <div class="card shadow-sm border-success mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Valid Examples
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Bachelor of Computer Science
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Bachelor of Business Administration
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Master of Information Technology
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- File Format Preview -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fas fa-table me-2"></i>
                Expected Excel Format
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-primary">
                        <tr>
                            <th>Programme Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="table-warning">
                            <td>Bachelor of Computer Science</td>
                        </tr>
                        <tr class="table-warning">
                            <td>Bachelor of Business Administration</td>
                        </tr>
                        <tr class="table-warning">
                            <td>Bachelor of Information Technology</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="text-muted mb-0">
                <i class="fas fa-lightbulb me-1"></i>
                <small>Yellow highlighted rows in the template are sample data - replace them with your actual programmes.</small>
            </p>
        </div>
    </div>
</div>