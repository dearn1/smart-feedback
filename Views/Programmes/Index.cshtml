@model IEnumerable<smart_feedback.Models.Programme>

@{
    ViewData["Title"] = ViewData["Title"];
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-graduation-cap text-primary me-2"></i>
            @ViewData["Title"]
        </h2>
        <div class="d-flex gap-2">
            <a asp-action="Upload" class="btn btn-success">
                <i class="fas fa-file-excel me-1"></i>
                Upload Excel
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>
                Create New Programme
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @Html.Raw(TempData["Success"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @Html.Raw(TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @Html.Raw(TempData["Warning"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" class="form-control" name="searchString" 
                               value="@ViewData["CurrentFilter"]" placeholder="Search programmes..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="fas fa-search me-1"></i>
                            Search
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i>
                            Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Programmes Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                Programmes
                <span class="badge bg-white text-primary ms-2">@Model.Count()</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th width="60px">#</th>
                            <th>
                                <i class="fas fa-graduation-cap me-1"></i>
                                Programme
                            </th>
                            <th width="200px" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int rowNumber = 1;
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center text-muted">@rowNumber</td>
                                    <td>
                                        <strong>@Html.DisplayFor(modelItem => item.ProgrammeName)</strong>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-warning" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                                        <h5>No programmes found</h5>
                                        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                                        {
                                            <p>No results match your search criteria.</p>
                                            <a asp-action="Index" class="btn btn-primary">
                                                <i class="fas fa-times me-1"></i>
                                                Clear Search
                                            </a>
                                        }
                                        else
                                        {
                                            <p>Get started by creating a new programme or uploading from Excel.</p>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a asp-action="Upload" class="btn btn-success">
                                                    <i class="fas fa-file-excel me-1"></i>
                                                    Upload Excel
                                                </a>
                                                <a asp-action="Create" class="btn btn-primary">
                                                    <i class="fas fa-plus me-1"></i>
                                                    Create New Programme
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.03);
    }

    .btn-group .btn {
        border-radius: 0;
    }

    .btn-group .btn:first-child {
        border-top-left-radius: 0.375rem;
        border-bottom-left-radius: 0.375rem;
    }

    .btn-group .btn:last-child {
        border-top-right-radius: 0.375rem;
        border-bottom-right-radius: 0.375rem;
    }
</style>