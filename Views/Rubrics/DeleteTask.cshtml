@model smart_feedback.Models.RubricTask

@{
    ViewData["Title"] = "Rubrics";
    var courseId = ViewBag.CourseId as string;
    var userRole = ViewBag.CurrentUserRole as string;
}

<h3>Are you sure you want to delete this task?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Task Title
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TaskTitle)
        </dd>
        <dt class = "col-sm-2">
            Task Description
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TaskDescription)
        </dd>
        <dt class = "col-sm-2">
            Max Marks
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaxMarks)
        </dd>
    </dl>
    
    <form asp-action="DeleteTask">
        <div class="d-flex gap-2 mb-3">
            <input type="hidden" asp-for="RubricTaskId" />
            <input type="hidden" asp-for="RubricsId" />
            <input type="hidden" name="rubricId" value="@ViewBag.RubricId" />
            <input type="hidden" name="courseid" value="@courseId" />
            <input type="hidden" name="role" value="@userRole" />
            <input type="submit" value="Delete" class="btn btn-primary" />
            <a asp-action="Details"
               asp-route-id="@ViewBag.RubricId"
               asp-route-courseid="@courseId"
               asp-route-role="@userRole"
               class="btn btn-secondary btn-sm">
                Cancel
            </a>
        </div>
    </form>
</div>
