@model smart_feedback.Models.Rubrics

@{
    ViewData["Title"] = "Rubrics";
    var courseId = ViewBag.CourseId as string;
    var userRole = ViewBag.CurrentUserRole as string;
}

<h3>Are you sure you want to delete this rubric?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Institution
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Institution)
        </dd>
        <dt class = "col-sm-2">
            Programme
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Programme)
        </dd>
        <dt class = "col-sm-2">
            Course Code
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CourseCode)
        </dd>
        <dt class = "col-sm-2">
            Course Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CourseName)
        </dd>
        <dt class="col-sm-2">
            Rubric Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RubricName)
        </dd>
        <dt class="col-sm-2">
            Term Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TermName)
        </dd>
        <dt class = "col-sm-2">
            Total Marks
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TotalMarks)
        </dd>
        <dt class = "col-sm-2">
            Source File
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SourceFile)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="RubricsId" />
        <input type="hidden" name="courseId" value="@courseId" />
        <input type="hidden" name="role" value="@userRole" />

        <div class="d-flex gap-2 mb-3">
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index"
               asp-route-courseId="@courseId"
               asp-route-role="@userRole"
               class="btn btn-secondary btn-sm">
                Cancel
            </a>
        </div>
    </form>
</div>
