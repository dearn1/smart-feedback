@model smart_feedback.Models.RubricDetailsViewModel

@{
    ViewData["Title"] = "Details";
    var courseId = ViewBag.CourseId as string;
    var userRole = ViewBag.CurrentUserRole as string;
}

<form asp-action="Details">
    <input type="hidden" name="courseId" value="@courseId" />
    <input type="hidden" name="role" value="@userRole" />
</form>

<div>
    <h4>Rubric Information</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Institution
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rubric.Institution)
        </dd>
        <dt class = "col-sm-2">
            Programme
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rubric.Programme)
        </dd>
        <dt class = "col-sm-2">
            Course Code
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rubric.CourseCode)
        </dd>
        <dt class = "col-sm-2">
            Course Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rubric.CourseName)
        </dd>
        <dt class="col-sm-2">
            Rubric Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Rubric.RubricName)
        </dd>
        <dt class="col-sm-2">
            Year
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Rubric.Year)
        </dd>
        <dt class="col-sm-2">
            Trimester
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Rubric.Trimester)
        </dd>
        <dt class="col-sm-2">
            Role
        </dt>
        <dd class="col-sm-10">            
            <span class="badge bg-info">@userRole</span>
        </dd>
    </dl>
</div>


<div class="btn-group gap-2" role="group">
    <a asp-action="Management"
       asp-controller="Rubrics"
       class="btn btn-secondary">Back to List</a>
</div>


<br />
<br />
<br />
<h4>Tasks Summary</h4>


@if (Model.RubricTasks.Any())
{
    @if (userRole != "Moderator")
    {
        <div>
            <a asp-action="CreateTask" class="btn btn-primary" asp-route-id="@Model.Rubric.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Add Task</a>
        </div>
    }
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Task Title</th>
                    <th>Task Description</th>
                    <th>Max Marks</th>
                    @if (userRole != "Moderator")
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RubricTasks)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.TaskTitle)</td>
                        <td>@Html.DisplayFor(modelItem => item.TaskDescription)</td>
                        <td>@Html.DisplayFor(modelItem => item.MaxMarks)</td>
                        @if (userRole != "Moderator")
                        {
                            <td>
                                <a asp-action="EditTask" class="btn btn-warning" asp-route-id="@item.RubricTaskId" asp-route-rubricId="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Edit</a>
                                <a asp-action="DeleteTask" class="btn btn-danger" asp-route-id="@item.RubricTaskId" asp-route-rubricId="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Delete</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    var totalMarks = Model.RubricTasks.Where(x => x.RubricsId == Model.Rubric.RubricsId).Sum(x => x.MaxMarks);

    <div class="alert alert-secondary">
        <strong>Total Marks for this rubric: @totalMarks %</strong>
    </div>
}
else
{
    <p>No tasks have been added to this rubric yet.</p>
    @if (userRole != "Moderator")
    {
        <a asp-action="CreateTask" class="btn btn-primary" asp-route-id="@Model.Rubric.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Add First Task</a>
    }

}


@if (Model.RubricTasks.Any())
{
    @foreach (var item in Model.RubricTasks)
    {
        <br />
        <br />
        <hr />
        <dt class="alert alert-info">
            @Html.DisplayFor(model => item.TaskTitle): @Html.DisplayFor(model => item.TaskDescription) [Point: @Html.DisplayFor(model => item.MaxMarks)]
        </dt>
        
        @if (Model.RubricCriterias.Any(x => x.RubricTaskId == item.RubricTaskId))
        {
            var firstCriteria = Model.RubricCriterias.FirstOrDefault(x => x.RubricTaskId == item.RubricTaskId);
            <div>
                @if (userRole != "Moderator")
                {
                    <a asp-action="CreateCriteria" class="btn btn-primary" asp-route-id="@item.RubricTaskId" asp-route-rubricsId="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Add Task Criteria</a>
                }

            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Criteria</th>
                            <th>Weight</th>
                            @foreach (var itemScore in Model.RubricCriteriaScores.Where(x => x.RubricCriteriaId == firstCriteria?.RubricCriteriaId))
                            {
                                <th>@itemScore.CriterionScore - @itemScore.ScoreTitle</th>
                            }
                            @if (userRole != "Moderator")
                            {
                                <th>Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var itemCriteria in Model.RubricCriterias.Where(x => x.RubricTaskId == item.RubricTaskId))
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => itemCriteria.CriterionTitle)</td>
                                <td>@Html.DisplayFor(modelItem => itemCriteria.Weight) %</td>
                                @foreach (var itemScore in Model.RubricCriteriaScores.Where(x => x.RubricCriteriaId == itemCriteria?.RubricCriteriaId))
                                {
                                    <td>@Html.DisplayFor(modelItem => itemScore.ScoreDescription)</td>
                                }
                                @if (userRole != "Moderator")
                                {
                                    <td>
                                        <a asp-action="EditCriteria" class="btn btn-warning" asp-route-criteriaId="@itemCriteria.RubricCriteriaId" asp-route-rubricId="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Edit</a>
                                        <a asp-action="DeleteCriteria" class="btn btn-danger" asp-route-criteriaId="@itemCriteria.RubricCriteriaId" asp-route-rubricId="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Delete</a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>


            var totalWeight = Model.RubricCriterias.Where(x => x.RubricTaskId == item.RubricTaskId).Sum(x => x.Weight);

            <div class="alert alert-secondary">
                <strong>Total Weight for this task: @totalWeight %</strong>
            </div>
        }
        else
        {
            <p>No criterias have been added to this task yet.</p>
            @if (userRole != "Moderator")
            {
                <a asp-action="CreateCriteria" class="btn btn-primary" asp-route-id="@item.RubricTaskId" asp-route-rubricsId="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Add First Task Criteria</a>
            }


            <div class="alert alert-secondary">
                <strong>Total Weight for this task: 0 %</strong>
            </div>
        }
    }
}