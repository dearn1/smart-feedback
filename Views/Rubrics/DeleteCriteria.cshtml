@model smart_feedback.Models.RubricCriteria

@{
    ViewData["Title"] = "Rubrics";
    var courseId = ViewBag.CourseId as string;
    var userRole = ViewBag.CurrentUserRole as string;
}

<h3>Are you sure you want to delete this criteria?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Criterion Title
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CriterionTitle)
        </dd>
        <dt class = "col-sm-2">
            Weight
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Weight) %
        </dd>
        <dt class = "col-sm-2">
            Max Score
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaxScore)
        </dd>
    </dl>
    
    <form asp-action="DeleteCriteria">
        <div class="d-flex gap-2 mb-3">
            <input type="hidden" name="criteriaId" value="@Model.RubricCriteriaId" />
            <input type="hidden" name="rubricId" value="@ViewBag.RubricId" />
            <input type="hidden" name="courseid" value="@courseId" />
            <input type="hidden" name="role" value="@userRole" />

            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Details"
               asp-route-id="@ViewBag.RubricId"
               asp-route-courseid="@courseId"
               asp-route-role="@userRole"
               class="btn btn-secondary btn-sm">
                Cancel
            </a>
        </div>
    </form>
</div>
