@model smart_feedback.Models.RubricCriteria

@{
    ViewData["Title"] = "DeleteCriteria";
}

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CriterionTitle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CriterionTitle)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Weight)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Weight) %
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MaxScore)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaxScore)
        </dd>
    </dl>
    
    <form asp-action="DeleteCriteria">
        <input type="hidden" name="criteriaId" value="@Model.RubricCriteriaId" />
        <input type="hidden" name="rubricId" value="@ViewBag.RubricId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Details" asp-route-id="@ViewBag.RubricId">Back to List</a>
    </form>
</div>
