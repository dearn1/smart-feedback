@model smart_feedback.Models.Rubrics

@{
    ViewData["Title"] = "Rubrics";
    var courseCode = ViewBag.CourseCode as string;
    var courseName = ViewBag.CourseName as string;
    var courseYear = ViewBag.CourseYear as string;
    var courseTrimester = ViewBag.CourseTrimester as string;
    var programme = ViewBag.Programme as string;
    var institution = ViewBag.Institution as string;
    var courseId = ViewBag.CourseId as string;
    var userRole = ViewBag.CurrentUserRole as string;
    var defaultInstitution = ViewBag.DefaultInstitution as string ?? "Auckland Institute of Studies";
}

<h4>Create</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">      
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="courseId" value="@courseId" />
            <input type="hidden" name="role" value="@userRole" />

            <div class="form-group">
                <label>Institution</label>
                <input asp-for="Institution" class="form-control" value="@(institution ?? defaultInstitution)" />
                <span asp-validation-for="Institution" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Programme</label>
                <select asp-for="Programme" class="form-control" asp-items="ViewBag.Programmes">
                    <option value="">-- Select Programme --</option>
                </select>
                <span asp-validation-for="Programme" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Course Code</label>
                <input asp-for="CourseCode" class="form-control" value="@courseCode" />
                <span asp-validation-for="CourseCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Course Name</label>
                <input asp-for="CourseName" class="form-control" value="@courseName" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Year</label>
                <select asp-for="Year" class="form-control" asp-items="ViewBag.Years">
                    <option value="">-- Select Year --</option>
                </select>
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Trimester</label>
                <select asp-for="Trimester" class="form-control" asp-items="ViewBag.Trimesters">
                    <option value="">-- Select Trimester --</option>
                </select>
                <span asp-validation-for="Trimester" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Rubric Name</label>
                <input asp-for="RubricName" class="form-control" />
                <span asp-validation-for="RubricName" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />

                <a asp-action="Management"
                   asp-controller="Rubrics"
                   class="btn btn-secondary btn-sm">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Pre-select values if they exist from ViewBag
        $(document).ready(function() {
            var programme = '@programme';
            var year = '@courseYear';
            var trimester = '@courseTrimester';
            
            if (programme) {
                $('#Programme').val(programme);
            }
            if (year) {
                $('#Year').val(year);
            }
            if (trimester) {
                $('#Trimester').val(trimester);
            }
        });
    </script>
}
