@model smart_feedback.Models.RubricCriteria

@{
    ViewData["Title"] = "Rubrics";
    var courseId = ViewBag.CourseId as string;
    var userRole = ViewBag.CurrentUserRole as string;
    var currentTotalWeight = ViewBag.CurrentTotalWeight ?? 0;
    var remainingWeight = ViewBag.RemainingWeight ?? 100;
}

<h4>Create Criteria</h4>
<hr />

<!-- Weight Information Display -->
<div class="alert alert-info">
    <h6><i class="fas fa-weight"></i> Weight Information</h6>
    <p><strong>Current Total Weight:</strong> @currentTotalWeight%</p>
    <p><strong>Remaining Weight:</strong> @remainingWeight%</p>
    @if (remainingWeight <= 0)
    {
        <div class="alert alert-warning">
            <strong>Warning:</strong> Maximum weight (100%) has been reached. You cannot add more criteria.
        </div>
    }
</div>

<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateCriteria">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RubricTaskId" />
            <input type="hidden" asp-for="RubricCriteriaId" />
            <input type="hidden" name="courseid" value="@courseId" />
            <input type="hidden" name="role" value="@userRole" />

            <div class="form-group">
                <label>Criterion Title</label>
                <input asp-for="CriterionTitle" class="form-control" />
                <span asp-validation-for="CriterionTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Weight</label>
                <input asp-for="Weight" class="form-control" />
                <span asp-validation-for="Weight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Max Score</label>
                @if (ViewBag.HasExistingCriteria == true)
                {
                    <input asp-for="MaxScore" value="@ViewBag.FirstExistingCriteria.MaxScore" class="form-control" type="number" min="1" max="10" readonly />
                }
                else
                {
                    <input asp-for="MaxScore" class="form-control" type="number" min="1" max="10" />
                }
                <span asp-validation-for="MaxScore" class="text-danger"></span>
            </div>

            <div id="scoreList" class="mt-3"></div>
            
            <div class="d-flex gap-2 mb-3">
                <input type="hidden" name="id" value="@ViewBag.RubricTaskId" />
                <input type="hidden" name="rubricsId" value="@ViewBag.RubricId" />
                @if (remainingWeight > 0)
                {
                    <input type="submit" value="Save Criteria" class="btn btn-primary" />
                }
                <a asp-action="Details"
                   asp-route-id="@ViewBag.RubricId"
                   asp-route-courseid="@courseId"
                   asp-route-role="@userRole"
                   class="btn btn-secondary btn-sm">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // validation for weight
        document.querySelector('input[name="Weight"]').addEventListener('input', function() {
            var weight = parseFloat(this.value) || 0;
            var remainingWeight = @remainingWeight;
            
            if (weight > remainingWeight) {
                this.setCustomValidity('Weight cannot exceed ' + remainingWeight + '%');
            } else {
                this.setCustomValidity('');
            }
        });

        var hasExistingCriteria = @Html.Raw(Json.Serialize(ViewBag.HasExistingCriteria ?? false));
        var existingScores = @Html.Raw(Json.Serialize(ViewBag.ExistingScores ?? new List<object>()));

        document.getElementById('MaxScore').addEventListener('change', function() {
            var input = this;
            var scoreListDiv = document.getElementById('scoreList');

            // ALWAYS clear first
            scoreListDiv.innerHTML = '';

            var maxScore = parseInt(this.value) || 0;

            // Check if validation passes
            if (!input.checkValidity()) {
                return; // Exit if validation fails
            }

            // Additional validation check
            if (maxScore < 1 || maxScore > 10) {
                return; // Exit if out of range
            }            

            if (maxScore > 0) {
                var html = '<div><strong>Score Descriptions:</strong><br/><div class="row mt-5">';

                for (var i = maxScore; i >= 0; i--) {
                    // Check if we have existing score data for this score level
                    var existingScore = null;
                    if (hasExistingCriteria && existingScores) {
                        existingScore = existingScores.find(function(score) {
                            return score.criterionScore === i;
                        });
                    }

                    html += '<div class="col-md-12 mb-3">';
                    html += '<div class="card">';
                    html += '<div class="card-header">';
                    html += '<span class="badge badge-primary" style="font-size: 1.5rem;">Score: ' + i + '</span>';
                    html += '</div>';
                    html += '<div class="card-body">';
                                    
                    // Pre-populate with existing data if available
                    var titleValue = existingScore ? existingScore.scoreTitle : '';
                    var titlePlaceholder = existingScore ? '' : 'Enter title for score ' + i + ' (eg. Excellent, Good, Fair, Poor)';
					var readonlyAttr = existingScore ? 'readonly' : '';
                                    
                    html += '<input type="text" class="form-control" ' +
					        readonlyAttr + ' ' +
                            'placeholder="' + titlePlaceholder + '" ' +
                            'value="' + titleValue + '" ' +
                            'name="ScoreTitle_' + i + '">';
                    html += '</div>';
                    html += '<div class="card-body">';
                                    
                    // Pre-populate description with existing data if available
                    var descPlaceholder = 'Enter description for score ' + i;
                                    
                    html += '<textarea class="form-control" rows="3" ' +
                            'placeholder="' + descPlaceholder + '" ' +
                            'name="ScoreDescription_' + i + '"></textarea>';
                    html += '</div>';
                    html += '</div>';
                    html += '</div>';
                }

                html += '</div></div>';
                scoreListDiv.innerHTML = html;
            }
        });

        // Auto-trigger the event if we have existing criteria to show the pre-populated form
        if (hasExistingCriteria) {
            // Trigger the change event after page load
            document.addEventListener('DOMContentLoaded', function() {
                var maxScoreInput = document.getElementById('MaxScore');
                if (maxScoreInput && maxScoreInput.value) {
                    maxScoreInput.dispatchEvent(new Event('change'));
                }
            });
        }
    </script>
             
}



