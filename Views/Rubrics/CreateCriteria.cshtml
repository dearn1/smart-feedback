@model smart_feedback.Models.RubricCriteria

@{
    ViewData["Title"] = "Create Task Criteria";
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateCriteria">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RubricTaskId" />
            <input type="hidden" asp-for="RubricCriteriaId" />
            <div class="form-group">
                <label asp-for="CriterionTitle" class="control-label"></label>
                <input asp-for="CriterionTitle" class="form-control" />
                <span asp-validation-for="CriterionTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Weight" class="control-label"></label>
                <input asp-for="Weight" class="form-control" />
                <span asp-validation-for="Weight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaxScore" class="control-label"></label>
                <input asp-for="MaxScore" class="form-control" type="number" min="1" max="10" />
                <span asp-validation-for="MaxScore" class="text-danger"></span>
            </div>
            <div id="scoreList" class="mt-3"></div>
            <div class="form-group">
                <input type="hidden" name="id" value="@ViewBag.RubricTaskId" />
                <input type="hidden" name="rubricsId" value="@ViewBag.RubricId" />
                <input type="submit" value="Save Criteria" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('MaxScore').addEventListener('change', function() {
            var input = this;
            var scoreListDiv = document.getElementById('scoreList');

            // ALWAYS clear first
            scoreListDiv.innerHTML = '';

            var maxScore = parseInt(this.value) || 0;

            // Check if validation passes
            if (!input.checkValidity()) {
                return; // Exit if validation fails
            }

            // Additional validation check
            if (maxScore < 1 || maxScore > 10) {
                return; // Exit if out of range
            }

            if (maxScore > 0) {
                var html = '<div><strong>Score Descriptions:</strong><br/><div class="row mt-5">';

                for (var i = maxScore; i >= 0; i--) {
                    html += '<div class="col-md-12 mb-3">';
                    html += '<div class="card">';
                    html += '<div class="card-header">';
                    html += '<span class="badge badge-primary" style="font-size: 1.5rem;">Score: ' + i + '</span>';
                    html += '</div>';
                    html += '<div class="card-body">';
                    html += '<textarea class="form-control" rows="3" placeholder="Enter description for score ' + i + '" name="ScoreDescription_' + i + '"></textarea>';
                    html += '</div>';
                    html += '</div>';
                    html += '</div>';
                }

                html += '</div></div>';
                scoreListDiv.innerHTML = html;
            }
        });
    </script>
}



