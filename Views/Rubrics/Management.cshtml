@model IEnumerable<smart_feedback.Models.Rubrics>

@{
    ViewData["Title"] = "Rubrics Management";
}

<!-- Filter Form -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-gradient-primary text-white">
        <h6 class="card-title mb-0 d-flex align-items-center">
            <i class="fas fa-filter me-2"></i>
            <span>Filter Rubrics</span>
        </h6>
        <div class="card-tools">
            <button type="button" class="btn btn-tool text-white" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body bg-light">
        <form asp-action="Management" method="get" id="filterForm">
            <div class="row g-3 align-items-end">
                <!-- Programme Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="form-group mb-0">
                        <label for="programmeFilter" class="form-label fw-semibold">
                            <i class="fas fa-graduation-cap text-success me-1"></i>
                            Programme
                        </label>
                        <select class="form-select form-select-sm" id="programmeFilter" name="programme">
                            <option value="">-- All Programmes --</option>
                            @foreach (var programme in ViewBag.Programmes as SelectList)
                            {
                                <option value="@programme.Text" selected="@(programme.Text == ViewBag.CurrentProgramme)">@programme.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Course Code Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="form-group mb-0">
                        <label for="courseCodeFilter" class="form-label fw-semibold">
                            <i class="fas fa-book text-danger me-1"></i>
                            Course Code
                        </label>
                        <select class="form-select form-select-sm" id="courseCodeFilter" name="courseCode">
                            <option value="">-- All Course Codes --</option>
                            @foreach (var courseCode in ViewBag.CourseCodes as SelectList)
                            {
                                <option value="@courseCode.Text" selected="@(courseCode.Text == ViewBag.CurrentCourseCode)">@courseCode.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Year Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="form-group mb-0">
                        <label for="yearFilter" class="form-label fw-semibold">
                            <i class="fas fa-calendar text-info me-1"></i>
                            Year
                        </label>
                        <select class="form-select form-select-sm" id="yearFilter" name="year">
                            <option value="">-- All Years --</option>
                            @foreach (var year in ViewBag.Years as SelectList)
                            {
                                <option value="@year.Text" selected="@(year.Text == ViewBag.CurrentYear?.ToString())">@year.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Trimester Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="form-group mb-0">
                        <label for="trimesterFilter" class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt text-warning me-1"></i>
                            Trimester
                        </label>
                        <select class="form-select form-select-sm" id="trimesterFilter" name="trimester">
                            <option value="">-- All Trimesters --</option>
                            @foreach (var trimester in ViewBag.Trimesters as SelectList)
                            {
                                <option value="@trimester.Text" selected="@(trimester.Text == ViewBag.CurrentTrimester?.ToString())">@trimester.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="col-lg-3 col-md-12">
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary btn-sm flex-fill">
                            <i class="fas fa-search me-1"></i>
                            Apply Filters
                        </button>
                        <a asp-action="Management" class="btn btn-outline-secondary btn-sm flex-fill" title="Clear all filters">
                            <i class="fas fa-times me-1"></i>
                            Clear
                        </a>
                    </div>
                </div>
            </div>

            <!-- Hidden Fields -->
            <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
        </form>
    </div>
</div>

<!-- Action Buttons -->
<div class="d-flex gap-2 mb-3">
    <a asp-action="Create" asp-route-courseid="" asp-route-role="@ViewBag.UserRole" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>
        Create New
    </a>
    <a asp-action="Upload" asp-route-courseid="" asp-route-role="@ViewBag.UserRole" class="btn btn-info">
        <i class="fas fa-upload me-1"></i>
        Upload
    </a>
</div>

<!-- Rubrics Table -->
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">
                <i class="fas fa-clipboard-list me-2"></i>
                All Rubrics
                <span class="badge bg-white text-primary ms-2">@Model.Count()</span>
            </h5>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Management"
                               asp-route-sortOrder="@ViewData["RubricNameSortParm"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               asp-route-courseCode="@ViewData["CurrentCourseCodeFilter"]"
                               asp-route-year="@ViewData["CurrentYearFilter"]"
                               asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                               asp-route-searchTerm="@ViewData["CurrentSearchTerm"]"
                               class="text-white text-decoration-none">
                                Rubric Name
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Management"
                               asp-route-sortOrder="@ViewData["CourseCodeSortParm"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               asp-route-courseCode="@ViewData["CurrentCourseCodeFilter"]"
                               asp-route-year="@ViewData["CurrentYearFilter"]"
                               asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                               asp-route-searchTerm="@ViewData["CurrentSearchTerm"]"
                               class="text-white text-decoration-none">
                                Course Code
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Management"
                               asp-route-sortOrder="@ViewData["CourseNameSortParm"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               asp-route-courseCode="@ViewData["CurrentCourseCodeFilter"]"
                               asp-route-year="@ViewData["CurrentYearFilter"]"
                               asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                               asp-route-searchTerm="@ViewData["CurrentSearchTerm"]"
                               class="text-white text-decoration-none">
                                Course Name
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Management"
                               asp-route-sortOrder="@ViewData["YearSortParm"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               asp-route-courseCode="@ViewData["CurrentCourseCodeFilter"]"
                               asp-route-year="@ViewData["CurrentYearFilter"]"
                               asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                               asp-route-searchTerm="@ViewData["CurrentSearchTerm"]"
                               class="text-white text-decoration-none">
                                Year
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Management"
                               asp-route-sortOrder="@ViewData["TrimesterSortParm"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               asp-route-courseCode="@ViewData["CurrentCourseCodeFilter"]"
                               asp-route-year="@ViewData["CurrentYearFilter"]"
                               asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                               asp-route-searchTerm="@ViewData["CurrentSearchTerm"]"
                               class="text-white text-decoration-none">
                                Trimester
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Management"
                               asp-route-sortOrder="@ViewData["ProgrammeSortParm"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               asp-route-courseCode="@ViewData["CurrentCourseCodeFilter"]"
                               asp-route-year="@ViewData["CurrentYearFilter"]"
                               asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                               asp-route-searchTerm="@ViewData["CurrentSearchTerm"]"
                               class="text-white text-decoration-none">
                                Programme
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Management"
                               asp-route-sortOrder="@ViewData["TotalMarksSortParm"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               asp-route-courseCode="@ViewData["CurrentCourseCodeFilter"]"
                               asp-route-year="@ViewData["CurrentYearFilter"]"
                               asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                               asp-route-searchTerm="@ViewData["CurrentSearchTerm"]"
                               class="text-white text-decoration-none">
                                Total Marks
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th width="150px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@Html.DisplayFor(modelItem => item.RubricName)</strong>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CourseCode)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CourseName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Year)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Trimester)
                                </td>
                                <td>
                                    <small>@Html.DisplayFor(modelItem => item.Programme)</small>
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        @Html.DisplayFor(modelItem => item.TotalMarks)
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group" aria-label="Actions">
                                        <a asp-action="Details" 
                                           asp-route-id="@item.RubricsId" 
                                           class="btn btn-info btn-sm" 
                                           title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        
                                        <a asp-action="Delete" 
                                            class="btn btn-danger btn-sm" 
                                            asp-route-id="@item.RubricsId" 
                                            asp-route-courseid="" 
                                            asp-route-role=""
                                           title="Delete">
                                           
                                            <i class="fas fa-trash"></i>
                                            
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                                    <h5>No rubrics found</h5>
                                    @if (ViewData["CurrentProgrammeFilter"] != null || ViewData["CurrentCourseCodeFilter"] != null || ViewData["CurrentYearFilter"] != null || ViewData["CurrentTrimesterFilter"] != null || !string.IsNullOrEmpty(ViewData["CurrentSearchTerm"]?.ToString()))
                                    {
                                        <p>No rubrics match your current filters. Try adjusting your search criteria.</p>
                                    }
                                    else
                                    {
                                        <p>No rubrics have been created yet in the system.</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Enhanced CSS -->
<style>
    .form-label {
        margin-bottom: 0.25rem;
        font-size: 0.875rem;
    }

    .card-header.bg-gradient-primary {
        background: linear-gradient(45deg, #007bff, #0056b3) !important;
    }

    .btn-tool:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 0.25rem;
    }

    .flex-fill {
        min-width: 100px;
    }

    .table th a:hover {
        text-decoration: underline;
    }

    .btn-group .btn {
        border-radius: 0.375rem;
    }

    .card-header.bg-primary {
        background-color: #007bff !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl/Cmd + Enter to submit form
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('filterForm').submit();
            }

            // Escape to clear filters
            if (e.key === 'Escape') {
                window.location.href = '@Url.Action("Management", "Rubrics")';
            }
        });
    });
</script>