@model smart_feedback.Models.Rubrics

@{
    ViewData["Title"] = "Rubrics";
    var courseId = ViewBag.CourseId as string;
    var userRole = ViewBag.CurrentUserRole as string;
}


<h4>Edit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RubricsId" />            
            <input type="hidden" asp-for="SourceFile" />
            <input type="hidden" name="courseId" value="@courseId" />
            <input type="hidden" name="role" value="@userRole" />
            <div class="form-group">
                <label>Institution</label>
                <input asp-for="Institution" class="form-control" readonly/>
                <span asp-validation-for="Institution" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Programme</label>
                <input asp-for="Programme" class="form-control" readonly />
                <span asp-validation-for="Programme" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Course Code</label>
                <input asp-for="CourseCode" class="form-control" readonly />
                <span asp-validation-for="CourseCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Course Name</label>
                <input asp-for="CourseName" class="form-control" readonly />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Rubric Name</label>
                <input asp-for="RubricName" class="form-control" />
                <span asp-validation-for="RubricName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Term Name</label>
                <input asp-for="TermName" class="form-control" readonly />
                <span asp-validation-for="TermName" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index"
                   asp-route-courseId="@courseId"
                   asp-route-role="@userRole"
                   class="btn btn-secondary btn-sm">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
