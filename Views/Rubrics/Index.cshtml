@model IEnumerable<smart_feedback.Models.Rubrics>

@{
    ViewData["Title"] = "Rubrics Management";
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="mb-2"><i class="bi bi-clipboard-check"></i> Rubrics Management</h1>
                <p class="mb-0 opacity-75">Create and manage assessment rubrics</p>
            </div>
        </div>
    </div>
</div>

@if (!User.IsInRole("Moderator"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
    <p>
        <a asp-action="Upload">Upload</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Institution)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Programme)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CourseCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CourseName)
            </th>            
            <th>
                @Html.DisplayNameFor(model => model.RubricName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TermName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Institution)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Programme)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CourseCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CourseName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RubricName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TermName)
                </td>
                <td>
                    @if (!User.IsInRole("Moderator"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.RubricsId">Edit</a>
                    }
                    |
                    <a asp-action="Details" asp-route-id="@item.RubricsId">Details</a> |
                    @if (!User.IsInRole("Moderator"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.RubricsId">Delete</a>
                    }

            </td>
        </tr>
}
    </tbody>
</table>
