@model IEnumerable<smart_feedback.Models.Rubrics>

@{
    ViewData["Title"] = "Rubrics Management";
    var courseCode = ViewBag.FilteredCourseCode as string;
    var courseName = ViewBag.FilteredCourseName as string;
    var courseTerm = ViewBag.FilteredCourseTerm as string;
    var courseId = ViewBag.CourseId as string;
    var userRole = ViewBag.CurrentUserRole as string;
    var lecturerName = ViewBag.LecturerName as string;
    var moderatorName = ViewBag.ModeratorName as string;
}

@if (!string.IsNullOrEmpty(courseCode) || !string.IsNullOrEmpty(courseTerm))
{
    <div class="alert alert-info">
        @if (!string.IsNullOrEmpty(courseCode))
        {
            <p><strong>Course:</strong> @courseCode @courseName</p>
        }
        @if (!string.IsNullOrEmpty(courseTerm))
        {
            <p><strong>Term:</strong> @courseTerm</p>
        }
        @if (!string.IsNullOrEmpty(lecturerName))
        {
            <p><strong>Lecturer:</strong> @lecturerName</p>
        }
        @if (!string.IsNullOrEmpty(moderatorName))
        {
            <p><strong>Moderator:</strong> @moderatorName</p>
        }
        @if (!string.IsNullOrEmpty(userRole))
        {
            <p><strong>Your Role:</strong> @userRole</p>
        }
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


@if (userRole != "Moderator")
{
    <div class="d-flex gap-2 mb-3">
        <a asp-action="Create" asp-route-courseid="@courseId" asp-route-role="@userRole" class="btn btn-primary">Create New</a>
        <a asp-action="Upload" asp-route-courseid="@courseId" asp-route-role="@userRole" class="btn btn-info">Upload</a>
    </div>
}
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>
                    Institution
                </th>
                <th>
                    Programme
                </th>
                <th>
                    Course Code
                </th>
                <th>
                    Course Name
                </th>            
                <th>
                    Rubric Name
                </th>
                <th>
                    Year
                </th>
                <th>
                    Trimester
                </th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Institution)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Programme)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CourseCode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CourseName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RubricName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Year)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Trimester)
                    </td>
                    <td>
                        @if (userRole != "Moderator")
                        {
                            <a asp-action="Edit" class="btn btn-warning btn-sm" asp-route-id="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Edit</a>
                        }
                        <a asp-action="Details" class="btn btn-info btn-sm" asp-route-id="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Details</a>
                        @if (userRole != "Moderator")
                        {
                            <a asp-action="Delete" class="btn btn-danger btn-sm" asp-route-id="@item.RubricsId" asp-route-courseid="@courseId" asp-route-role="@userRole">Delete</a>
                        }
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>
