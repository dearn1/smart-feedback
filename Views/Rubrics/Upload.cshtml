@model smart_feedback.Models.Rubrics

@{
    ViewData["Title"] = "Upload";
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Upload" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Upload Your Rubrics</label>
                <input type="file" name="rubricsFile" class="form-control" accept=".doc,.docx" />
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }
                <span class="text-muted">Accepted formats: DOC, DOCX (Max size: 10MB)</span>
                <span asp-validation-for="SourceFile" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Upload Rubrics" class="btn btn-primary" />
                <a asp-action="Index" asp-controller="Rubrics" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

