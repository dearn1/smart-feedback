@model smart_feedback.Models.CourseRoles

@{
    ViewData["Title"] = "Course Roles";
}

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Course Code
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CourseCode)
        </dd>
        <dt class = "col-sm-2">
            Course Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CourseName)
        </dd>
        <dt class="col-sm-2">
            Term Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TermName)
        </dd>
        <dt class="col-sm-2">
            Programme
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Programme)
        </dd>
        <dt class="col-sm-2">
            Institution
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Institution)
        </dd>
        <dt class = "col-sm-2">
            Role Lecturer
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RoleLecturer)
        </dd>
        <dt class = "col-sm-2">
            Role Moderator
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RoleModerator)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CourseRolesId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
