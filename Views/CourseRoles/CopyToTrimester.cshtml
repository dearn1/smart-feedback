@{
    ViewData["Title"] = "Copy Course Roles to New Trimester";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="fas fa-copy text-primary me-2"></i>
                Copy Course Roles to New Trimester
            </h2>
            <p class="text-muted">Select source course roles and copy them to a new year/trimester combination.</p>
        </div>
    </div>

    <!-- Source Filter Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-filter me-2"></i>
                Step 1: Select Source Data
            </h5>
        </div>
        <div class="card-body">
            <form id="sourceFilterForm">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="sourceYear" class="form-label fw-semibold">
                            <i class="fas fa-calendar text-primary me-1"></i>
                            Source Year <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="sourceYear" name="sourceYear" required>
                            <option value="">-- Select Year --</option>
                            @foreach (var year in ViewBag.Years as SelectList)
                            {
                                <option value="@year.Text">@year.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="sourceTrimester" class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt text-info me-1"></i>
                            Source Trimester <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="sourceTrimester" name="sourceTrimester" required>
                            <option value="">-- Select Trimester --</option>
                            @foreach (var trimester in ViewBag.Trimesters as SelectList)
                            {
                                <option value="@trimester.Text">Trimester @trimester.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="sourceProgramme" class="form-label fw-semibold">
                            <i class="fas fa-graduation-cap text-success me-1"></i>
                            Source Programme <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="sourceProgramme" name="sourceProgramme" required>
                            <option value="">-- Select Programme --</option>
                            <option value="ALL">All Programmes</option>
                            @foreach (var option in (List<SelectListItem>)ViewBag.ProgrammeOptions)
                            {
                                @if (!string.IsNullOrEmpty(option.Value))
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="button" id="loadSourceBtn" class="btn btn-primary">
                        <i class="fas fa-search me-1"></i>
                        Load Source Data
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Preview Table Card -->
    <div class="card shadow-sm mb-4" id="previewCard" style="display: none;">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                Step 2: Select Course Roles to Copy
                <span class="badge bg-white text-success ms-2" id="totalCount">0</span>
            </h5>
            <div id="selectionActions" style="display: none;">
                <span class="badge bg-white text-success" id="selectedCount">0 selected</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="previewTable">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" id="selectAll" class="form-check-input" title="Select All">
                            </th>
                            <th>Course Code</th>
                            <th>Course Name</th>
                            <th>Year</th>
                            <th>Trimester</th>
                            <th>Programme</th>
                            <th>Institution</th>
                            <th>Lecturer</th>
                            <th>Moderator</th>
                            <th>Total Assessment</th>
                        </tr>
                    </thead>
                    <tbody id="previewTableBody">
                        <!-- Data will be populated here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Destination Settings Card -->
    <div class="card shadow-sm mb-4" id="destinationCard" style="display: none;">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">
                <i class="fas fa-bullseye me-2"></i>
                Step 3: Configure Destination
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="CopyToTrimester" method="post" id="copyForm">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="destinationYear" class="form-label fw-semibold">
                            <i class="fas fa-calendar text-primary me-1"></i>
                            Destination Year <span class="text-danger">*</span>
                        </label>
                        <input type="number" class="form-control" id="destinationYear" name="destinationYear" 
                               value="@ViewBag.DefaultDestYear" min="2020" max="2100" required>
                    </div>

                    <div class="col-md-6">
                        <label for="destinationTrimester" class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt text-info me-1"></i>
                            Destination Trimester <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="destinationTrimester" name="destinationTrimester" required>
                            <option value="">-- Select Trimester --</option>
                            <option value="1" selected="@(ViewBag.DefaultDestTrimester == 1)">Trimester 1</option>
                            <option value="2" selected="@(ViewBag.DefaultDestTrimester == 2)">Trimester 2</option>
                            <option value="3" selected="@(ViewBag.DefaultDestTrimester == 3)">Trimester 3</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-eraser text-warning me-1"></i>
                            Blank Out Options
                        </label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="blankLecturer" name="blankLecturer" value="true">
                            <label class="form-check-label" for="blankLecturer">
                                <i class="fas fa-user-times text-danger me-1"></i>
                                Blank out Role Lecturer field
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="blankModerator" name="blankModerator" value="true">
                            <label class="form-check-label" for="blankModerator">
                                <i class="fas fa-user-times text-danger me-1"></i>
                                Blank out Role Moderator field
                            </label>
                        </div>
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Selected fields will be cleared in the copied records
                        </small>
                    </div>
                </div>

                <!-- Hidden field container for selected IDs -->
                <div id="selectedIdsContainer"></div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success" id="copyBtn" disabled>
                        <i class="fas fa-copy me-1"></i>
                        Copy Selected Course Roles
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Info Card -->
    <div class="card shadow-sm border-info">
        <div class="card-body">
            <h6 class="card-title text-info">
                <i class="fas fa-info-circle me-2"></i>
                How to Use This Feature
            </h6>
            <ol class="mb-0">
                <li>Select the source <strong>Year</strong>, <strong>Trimester</strong>, and <strong>Programme</strong> to find course roles</li>
                <li>Click <strong>"Load Source Data"</strong> to display matching course roles</li>
                <li>Select individual course roles or use <strong>"Select All"</strong> checkbox</li>
                <li>Configure the destination <strong>Year</strong> and <strong>Trimester</strong></li>
                <li>Optionally blank out <strong>Lecturer</strong> and/or <strong>Moderator</strong> fields</li>
                <li>Click <strong>"Copy Selected Course Roles"</strong> to complete the operation</li>
            </ol>
            <div class="alert alert-warning mt-3 mb-0">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Note:</strong> Duplicate course roles (same Course Code, Year, Trimester, and Programme) will be automatically skipped.
            </div>
        </div>
    </div>
</div>

<!-- Enhanced CSS -->
<style>
    .form-label {
        margin-bottom: 0.25rem;
        font-size: 0.9rem;
    }

    .form-check-input {
        cursor: pointer;
    }

    .form-check-input:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    tr.selected-row {
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    .table tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.03);
    }

    #previewCard, #destinationCard {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const loadSourceBtn = document.getElementById('loadSourceBtn');
        const sourceYear = document.getElementById('sourceYear');
        const sourceTrimester = document.getElementById('sourceTrimester');
        const sourceProgramme = document.getElementById('sourceProgramme');
        const previewCard = document.getElementById('previewCard');
        const destinationCard = document.getElementById('destinationCard');
        const previewTableBody = document.getElementById('previewTableBody');
        const selectAll = document.getElementById('selectAll');
        const totalCount = document.getElementById('totalCount');
        const selectedCount = document.getElementById('selectedCount');
        const selectionActions = document.getElementById('selectionActions');
        const copyBtn = document.getElementById('copyBtn');
        const selectedIdsContainer = document.getElementById('selectedIdsContainer');
        const copyForm = document.getElementById('copyForm');

        let courseRolesData = [];

        // Load source data
        loadSourceBtn.addEventListener('click', async function() {
            const year = sourceYear.value;
            const trimester = sourceTrimester.value;
            const programme = sourceProgramme.value;

            if (!year || !trimester || !programme) {
                alert('Please select Year, Trimester, and Programme.');
                return;
            }

            loadSourceBtn.disabled = true;
            loadSourceBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Loading...';

            try {
                const response = await fetch('@Url.Action("GetCopyPreview", "CourseRoles")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `sourceYear=${year}&sourceTrimester=${trimester}&sourceProgramme=${encodeURIComponent(programme)}`
                });

                const result = await response.json();

                if (result.success && result.data.length > 0) {
                    courseRolesData = result.data;
                    renderPreviewTable();
                    previewCard.style.display = 'block';
                    destinationCard.style.display = 'block';
                    totalCount.textContent = courseRolesData.length;
                } else {
                    alert(result.message || 'No course roles found matching the selected criteria.');
                    previewCard.style.display = 'none';
                    destinationCard.style.display = 'none';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while loading course roles.');
            } finally {
                loadSourceBtn.disabled = false;
                loadSourceBtn.innerHTML = '<i class="fas fa-search me-1"></i> Load Source Data';
            }
        });

        // Render preview table
        function renderPreviewTable() {
            previewTableBody.innerHTML = '';

            courseRolesData.forEach(item => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>
                        <input type="checkbox" class="form-check-input row-checkbox" value="${item.courseRolesId}" data-id="${item.courseRolesId}">
                    </td>
                    <td>${item.courseCode}</td>
                    <td>${item.courseName}</td>
                    <td>${item.year}</td>
                    <td>${item.trimester}</td>
                    <td>${item.programme}</td>
                    <td>${item.institution}</td>
                    <td>${item.roleLecturer || ''}</td>
                    <td>${item.roleModerator || ''}</td>
                    <td><span class="badge bg-info">${item.totalAssessment}</span></td>
                `;
                previewTableBody.appendChild(row);
            });

            // Attach event listeners to checkboxes
            attachCheckboxListeners();
        }

        // Attach checkbox event listeners
        function attachCheckboxListeners() {
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');

            // Select all functionality
            selectAll.addEventListener('change', function() {
                rowCheckboxes.forEach(checkbox => {
                    checkbox.checked = this.checked;
                    updateRowHighlight(checkbox);
                });
                updateSelectionCount();
            });

            // Individual checkbox change
            rowCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    updateRowHighlight(this);
                    updateSelectionCount();
                    
                    // Update select all checkbox
                    selectAll.checked = Array.from(rowCheckboxes).every(cb => cb.checked);
                });
            });
        }

        // Update row highlight
        function updateRowHighlight(checkbox) {
            const row = checkbox.closest('tr');
            if (checkbox.checked) {
                row.classList.add('selected-row');
            } else {
                row.classList.remove('selected-row');
            }
        }

        // Update selection count
        function updateSelectionCount() {
            const rowCheckboxes = document.querySelectorAll('.row-checkbox');
            const checkedCount = Array.from(rowCheckboxes).filter(cb => cb.checked).length;

            selectedCount.textContent = `${checkedCount} selected`;

            if (checkedCount > 0) {
                selectionActions.style.display = 'block';
                copyBtn.disabled = false;
            } else {
                selectionActions.style.display = 'none';
                copyBtn.disabled = true;
            }
        }

        // Form submission
        copyForm.addEventListener('submit', function(e) {
            const rowCheckboxes = document.querySelectorAll('.row-checkbox:checked');
            
            if (rowCheckboxes.length === 0) {
                e.preventDefault();
                alert('Please select at least one course role to copy.');
                return false;
            }

            const destinationYear = document.getElementById('destinationYear').value;
            const destinationTrimester = document.getElementById('destinationTrimester').value;

            if (!destinationYear || !destinationTrimester) {
                e.preventDefault();
                alert('Please select destination Year and Trimester.');
                return false;
            }

            // Clear previous hidden fields
            selectedIdsContainer.innerHTML = '';

            // Add selected IDs as hidden fields
            rowCheckboxes.forEach(checkbox => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedIds';
                input.value = checkbox.value;
                selectedIdsContainer.appendChild(input);
            });

            // Confirm before copying
            const count = rowCheckboxes.length;
            const blankLecturer = document.getElementById('blankLecturer').checked;
            const blankModerator = document.getElementById('blankModerator').checked;
            
            let confirmMsg = `Are you sure you want to copy ${count} course role(s) to ${destinationYear} - Trimester ${destinationTrimester}?`;
            
            if (blankLecturer || blankModerator) {
                confirmMsg += '\n\nThe following fields will be blanked out:';
                if (blankLecturer) confirmMsg += '\n- Lecturer';
                if (blankModerator) confirmMsg += '\n- Moderator';
            }

            if (!confirm(confirmMsg)) {
                e.preventDefault();
                return false;
            }

            copyBtn.disabled = true;
            copyBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Copying...';
        });
    });
</script>