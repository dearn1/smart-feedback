<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ==================== ACTIVE TABLE ====================
        const selectAllActive = document.getElementById('selectAllActive');
        const rowCheckboxesActive = document.querySelectorAll('.row-checkbox-active');
        const bulkActionsActive = document.getElementById('bulkActionsActive');
        const selectedCountActiveSpan = document.getElementById('selectedCountActive');
        const archiveSelectedBtn = document.getElementById('archiveSelectedBtn');
        const clearSelectionActiveBtn = document.getElementById('clearSelectionActiveBtn');
        const bulkArchiveForm = document.getElementById('bulkArchiveForm');

        // Select/Deselect all active rows
        if (selectAllActive) {
            selectAllActive.addEventListener('change', function() {
                rowCheckboxesActive.forEach(checkbox => {
                    checkbox.checked = this.checked;
                    updateRowHighlight(checkbox);
                });
                updateBulkActionsActive();
            });
        }

        // Handle individual checkbox changes for active rows
        rowCheckboxesActive.forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                updateRowHighlight(this);
                updateBulkActionsActive();
                
                // Update select all checkbox
                if (selectAllActive) {
                    selectAllActive.checked = Array.from(rowCheckboxesActive).every(cb => cb.checked);
                }
            });
        });

        // Update bulk actions visibility for active table
        function updateBulkActionsActive() {
            const selectedCount = Array.from(rowCheckboxesActive).filter(cb => cb.checked).length;
            selectedCountActiveSpan.textContent = selectedCount;
            
            if (selectedCount > 0) {
                bulkActionsActive.style.display = 'block';
            } else {
                bulkActionsActive.style.display = 'none';
            }
        }

        // Clear selection for active rows
        if (clearSelectionActiveBtn) {
            clearSelectionActiveBtn.addEventListener('click', function() {
                rowCheckboxesActive.forEach(checkbox => {
                    checkbox.checked = false;
                    updateRowHighlight(checkbox);
                });
                if (selectAllActive) {
                    selectAllActive.checked = false;
                }
                updateBulkActionsActive();
            });
        }

        // Archive selected rows - USING AJAX
        if (archiveSelectedBtn) {
            archiveSelectedBtn.addEventListener('click', async function(e) {
                e.preventDefault();
                
                const checkedBoxes = Array.from(rowCheckboxesActive).filter(cb => cb.checked);
                const selectedIds = checkedBoxes.map(cb => parseInt(cb.value));
                const selectedCount = selectedIds.length;
                
                console.log('Archive button clicked');
                console.log('Selected IDs:', selectedIds);
                
                if (selectedCount === 0) {
                    alert('Please select at least one course role to archive.');
                    return;
                }
                
                if (!confirm(`Are you sure you want to archive ${selectedCount} course role(s)?`)) {
                    return;
                }
                
                try {
                    // Get the anti-forgery token
                    const token = bulkArchiveForm.querySelector('input[name="__RequestVerificationToken"]').value;
                    console.log('Anti-forgery token:', token);
                    
                    // Create form data
                    const formData = new FormData();
                    selectedIds.forEach(id => {
                        formData.append('selectedIds', id);
                    });
                    
                    // Log what we're sending
                    console.log('Sending FormData:');
                    for (let pair of formData.entries()) {
                        console.log(pair[0] + ': ' + pair[1]);
                    }
                    
                    // Send AJAX request
                    const response = await fetch('@Url.Action("BulkArchive", "CourseRoles")', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });
                    
                    console.log('Response status:', response.status);
                    console.log('Response OK:', response.ok);
                    
                    if (response.ok) {
                        // Reload the page to show updated data
                        window.location.reload();
                    } else {
                        const errorText = await response.text();
                        console.error('Error response:', errorText);
                        alert('Error archiving course roles. Check console for details.');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred: ' + error.message);
                }
            });
        }

        // ==================== SHARED FUNCTIONS ====================
        // Update row highlight
        function updateRowHighlight(checkbox) {
            const row = checkbox.closest('tr');
            if (checkbox.checked) {
                row.classList.add('selected-row');
            } else {
                row.classList.remove('selected-row');
            }
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl/Cmd + Enter to submit form
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('filterForm').submit();
            }

            // Escape to clear filters
            if (e.key === 'Escape') {
                window.location.href = '@Url.Action("Index", "CourseRoles")';
            }
        });

        // ==================== ARCHIVED TABLE COLLAPSE ====================
        const archivedTableHeader = document.getElementById('archivedTableHeader');
        const archivedTableCollapse = document.getElementById('archivedTableCollapse');
        const archivedChevron = document.getElementById('archivedChevron');

        if (archivedTableHeader) {
            archivedTableHeader.addEventListener('click', function() {
                const isCollapsed = archivedTableCollapse.style.display === 'none' || archivedTableCollapse.style.display === '';

                if (isCollapsed) {
                    archivedTableCollapse.style.display = 'block';
                    archivedChevron.classList.remove('fa-chevron-down');
                    archivedChevron.classList.add('fa-chevron-up');
                } else {
                    archivedTableCollapse.style.display = 'none';
                    archivedChevron.classList.remove('fa-chevron-up');
                    archivedChevron.classList.add('fa-chevron-down');
                }
            });
        }
    });
</script>

