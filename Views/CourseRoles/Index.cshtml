@model IEnumerable<smart_feedback.Models.CourseRoles>

@{
    ViewData["Title"] = "Course Roles";
}

<div class="d-flex gap-2 mb-3">
    <a asp-action="Upload" class="btn btn-info">Upload CSV</a>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>
                    Course Code
                </th>
                <th>
                    Course Name
                </th>
                <th>
                    Term Name
                </th>
                <th>
                    Programme
                </th>
                <th>
                    Institution
                </th>
                <th>
                    Role Lecturer
                </th>
                <th>
                    Role Moderator
                </th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CourseCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CourseName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TermName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Programme)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Institution)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RoleLecturer)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RoleModerator)
                </td>
                <td>
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-route-id="@item.CourseRolesId">Edit</a>
                    <a asp-action="Details" class="btn btn-info btn-sm" asp-route-id="@item.CourseRolesId">Details</a>
                    <a asp-action="Delete" class="btn btn-danger btn-sm" asp-route-id="@item.CourseRolesId">Delete</a>
                    <a href="#" class="btn btn-dark btn-sm">Archive</a>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>