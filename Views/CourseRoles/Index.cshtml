@model IEnumerable<smart_feedback.Models.CourseRoles>

@{
    ViewData["Title"] = "Course Roles";
    var activeCourseRoles = Model?.Where(cr => cr.Status == "Active") ?? Enumerable.Empty<smart_feedback.Models.CourseRoles>();
    var archivedCourseRoles = Model?.Where(cr => cr.Status == "Archived") ?? Enumerable.Empty<smart_feedback.Models.CourseRoles>();
}

<!-- Filter Form -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-gradient-primary text-white">
        <h6 class="card-title mb-0 d-flex align-items-center">
            <i class="fas fa-filter me-2"></i>
            <span>Filter Course Roles</span>
        </h6>
        <div class="card-tools">
            <button type="button" class="btn btn-tool text-white" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body bg-light">
        <form asp-action="Index" method="get" id="filterForm">
            <div class="row g-3 align-items-end">
                <!-- Year Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="form-group mb-0">
                        <label for="yearFilter" class="form-label fw-semibold">
                            <i class="fas fa-calendar text-primary me-1"></i>
                            Year
                        </label>
                        <select class="form-select form-select-sm" id="yearFilter" name="year">
                            <option value="">-- All Years --</option>
                            @foreach (var year in ViewBag.Years as SelectList)
                            {
                                <option value="@year.Text" selected="@(year.Text == ViewBag.CurrentYear?.ToString())">@year.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Trimester Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="form-group mb-0">
                        <label for="trimesterFilter" class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt text-info me-1"></i>
                            Trimester
                        </label>
                        <select class="form-select form-select-sm" id="trimesterFilter" name="trimester">
                            <option value="">-- All Trimesters --</option>
                            @foreach (var trimester in ViewBag.Trimesters as SelectList)
                            {
                                <option value="@trimester.Text" selected="@(trimester.Text == ViewBag.CurrentTrimester?.ToString())">@trimester.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Programme Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="form-group mb-0">
                        <label for="programmeFilter" class="form-label fw-semibold">
                            <i class="fas fa-graduation-cap text-success me-1"></i>
                            Programme
                        </label>
                        <select class="form-select form-select-sm" id="programmeFilter" name="programme">
                            @foreach (var option in (List<SelectListItem>)ViewBag.ProgrammeOptions)
                            {
                                <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="col-lg-3 col-md-12">
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary btn-sm flex-fill">
                            <i class="fas fa-search me-1"></i>
                            Apply Filters
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm flex-fill" title="Clear all filters">
                            <i class="fas fa-times me-1"></i>
                            Clear
                        </a>
                    </div>
                </div>
            </div>

            <!-- Hidden Fields -->
            <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
        </form>
    </div>
</div>

<!-- Action Buttons -->
<div class="d-flex gap-2 mb-3">
    <a asp-action="DownloadTemplate" class="btn btn-outline-success">
        <i class="fas fa-download"></i> Download Template
    </a>
    <a asp-action="Upload" class="btn btn-success">
        <i class="fas fa-file-excel"></i> Upload Excel
    </a>
    <a asp-action="DownloadData"
       asp-route-sortOrder="@ViewData["CurrentSort"]"
       asp-route-year="@ViewData["CurrentYearFilter"]"
       asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
       asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
       class="btn btn-info">
        <i class="fas fa-file-excel"></i> Download Data
    </a>    
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Create New
    </a>
</div>

<!-- Active Course Roles Table -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">
                <i class="fas fa-check-circle me-2"></i>
                Active Course Roles
                <span class="badge bg-white text-success ms-2">@activeCourseRoles.Count()</span>
            </h5>
        </div>
        <div id="bulkActionsActive" style="display: none;">
            <button type="button" class="btn btn-dark btn-sm" id="archiveSelectedBtn">
                <i class="fas fa-archive me-1"></i>
                Archive Selected (<span id="selectedCountActive">0</span>)
            </button>
            <button type="button" class="btn btn-outline-light btn-sm" id="clearSelectionActiveBtn">
                <i class="fas fa-times me-1"></i>
                Clear
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <form id="bulkArchiveForm" asp-action="BulkArchive" method="post">
                @Html.AntiForgeryToken()
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" id="selectAllActive" class="form-check-input" title="Select All">
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["CourseCodeSortParm"]"
                                   asp-route-year="@ViewData["CurrentYearFilter"]"
                                   asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                                   asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                                   class="text-white text-decoration-none">
                                    Course Code
                                    <i class="fas fa-sort"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["CourseNameSortParm"]"
                                   asp-route-year="@ViewData["CurrentYearFilter"]"
                                   asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                                   asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                                   class="text-white text-decoration-none">
                                    Course Name
                                    <i class="fas fa-sort"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["YearSortParm"]"
                                   asp-route-year="@ViewData["CurrentYearFilter"]"
                                   asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                                   asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                                   class="text-white text-decoration-none">
                                    Year
                                    <i class="fas fa-sort"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["TrimesterSortParm"]"
                                   asp-route-year="@ViewData["CurrentYearFilter"]"
                                   asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                                   asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                                   class="text-white text-decoration-none">
                                    Trimester
                                    <i class="fas fa-sort"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["ProgrammeSortParm"]"
                                   asp-route-year="@ViewData["CurrentYearFilter"]"
                                   asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                                   asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                                   class="text-white text-decoration-none">
                                    Programme
                                    <i class="fas fa-sort"></i>
                                </a>
                            </th>
                            <th>Institution</th>
                            <th>Role Lecturer</th>
                            <th>Role Moderator</th>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@ViewData["TotalAssessmentSortParm"]"
                                   asp-route-year="@ViewData["CurrentYearFilter"]"
                                   asp-route-trimester="@ViewData["CurrentTrimesterFilter"]"
                                   asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                                   class="text-white text-decoration-none">
                                    Total Assessment
                                    <i class="fas fa-sort"></i>
                                </a>
                            </th>
                            <th width="200px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (activeCourseRoles.Any())
                        {
                            @foreach (var item in activeCourseRoles)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="selectedIds" value="@item.CourseRolesId" class="form-check-input row-checkbox-active">
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CourseCode)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CourseName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Year)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Trimester)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Programme)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Institution)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.RoleLecturer)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.RoleModerator)
                                    </td>
                                    <td>
                                        <span class="badge bg-info">
                                            @Html.DisplayFor(modelItem => item.TotalAssessment)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group" aria-label="Actions">
                                            <a asp-action="Edit" class="btn btn-warning btn-sm" asp-route-id="@item.CourseRolesId" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" class="btn btn-info btn-sm" asp-route-id="@item.CourseRolesId" title="Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Delete" class="btn btn-danger btn-sm" asp-route-id="@item.CourseRolesId" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                            <form asp-action="Archive" asp-route-id="@item.CourseRolesId" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-dark btn-sm" title="Archive" onclick="return confirm('Are you sure you want to archive this course role?');">
                                                    <i class="fas fa-archive"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                                        <h5>No active course roles found</h5>
                                        @if (ViewData["CurrentYearFilter"] != null || ViewData["CurrentTrimesterFilter"] != null || !string.IsNullOrEmpty(ViewData["CurrentProgrammeFilter"]?.ToString()))
                                        {
                                            <p>No active results match your current filters.</p>
                                        }
                                        else
                                        {
                                            <p>Get started by creating a new course role or uploading an Excel file.</p>
                                            <div class="mt-3">
                                                <a asp-action="Create" class="btn btn-primary me-2">
                                                    <i class="fas fa-plus me-1"></i>
                                                    Create New
                                                </a>
                                                <a asp-action="Upload" class="btn btn-success me-2">
                                                    <i class="fas fa-file-excel me-1"></i>
                                                    Upload Excel
                                                </a>
                                                <a asp-action="DownloadTemplate" class="btn btn-outline-success">
                                                    <i class="fas fa-download me-1"></i>
                                                    Download Template
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </form>
        </div>
    </div>
</div>

