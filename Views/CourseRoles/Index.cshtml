@model IEnumerable<smart_feedback.Models.CourseRoles>

@{
    ViewData["Title"] = "Course Roles";
}

<!-- Filter Form -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-gradient-primary text-white">
        <h6 class="card-title mb-0 d-flex align-items-center">
            <i class="fas fa-filter me-2"></i>
            <span>Filter Course Roles</span>
        </h6>
        <div class="card-tools">
            <button type="button" class="btn btn-tool text-white" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body bg-light">
        <form asp-action="Index" method="get" id="filterForm">
            <div class="row g-3 align-items-end">
                <!-- Term Name Filter -->
                <div class="col-lg-4 col-md-6">
                    <div class="form-group mb-0">
                        <label for="termNameFilter" class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt text-primary me-1"></i>
                            Term Name
                        </label>
                        <div class="input-group">
                            <input type="text"
                                   class="form-control form-control-sm"
                                   id="termNameFilter"
                                   name="termName"
                                   value="@ViewData["CurrentTermFilter"]"
                                   placeholder="Enter term name..."
                                   autocomplete="off">
                            <div class="input-group-append">
                                <span class="input-group-text bg-white border-start-0">
                                    <i class="fas fa-search text-muted"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Programme Filter -->
                <div class="col-lg-4 col-md-6">
                    <div class="form-group mb-0">
                        <label for="programmeFilter" class="form-label fw-semibold">
                            <i class="fas fa-graduation-cap text-success me-1"></i>
                            Programme
                        </label>
                        <select class="form-select form-select-sm" id="programmeFilter" name="programme">
                            @foreach (var option in (List<SelectListItem>)ViewBag.ProgrammeOptions)
                            {
                                <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="col-lg-4 col-md-12">
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary btn-sm flex-fill">
                            <i class="fas fa-search me-1"></i>
                            Apply Filters
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm flex-fill" title="Clear all filters">
                            <i class="fas fa-times me-1"></i>
                            Clear
                        </a>
                    </div>
                </div>
            </div>

            <!-- Hidden Fields -->
            <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
        </form>
    </div>
</div>

<!-- Action Buttons -->
<div class="d-flex gap-2 mb-3">
    <a asp-action="Upload" class="btn btn-info">
        <i class="fas fa-upload"></i> Upload CSV
    </a>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Create New
    </a>
</div>


<!-- Course Roles Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["CourseCodeSortParm"]"
                               asp-route-termName="@ViewData["CurrentTermFilter"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               class="text-white text-decoration-none">
                                Course Code
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["CourseNameSortParm"]"
                               asp-route-termName="@ViewData["CurrentTermFilter"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               class="text-white text-decoration-none">
                                Course Name
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["TermNameSortParm"]"
                               asp-route-termName="@ViewData["CurrentTermFilter"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               class="text-white text-decoration-none">
                                Term Name
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["ProgrammeSortParm"]"
                               asp-route-termName="@ViewData["CurrentTermFilter"]"
                               asp-route-programme="@ViewData["CurrentProgrammeFilter"]"
                               class="text-white text-decoration-none">
                                Programme
                                <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>Institution</th>
                        <th>Role Lecturer</th>
                        <th>Role Moderator</th>
                        <th width="200px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CourseCode)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CourseName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TermName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Programme)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Institution)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RoleLecturer)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RoleModerator)
                                </td>
                                <td>
                                    <div class="btn-group" role="group" aria-label="Actions">
                                        <a asp-action="Edit" class="btn btn-warning btn-sm" asp-route-id="@item.CourseRolesId" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" class="btn btn-info btn-sm" asp-route-id="@item.CourseRolesId" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" class="btn btn-danger btn-sm" asp-route-id="@item.CourseRolesId" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                        <a href="#" class="btn btn-dark btn-sm" title="Archive" onclick="return false;">
                                            <i class="fas fa-archive"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                                    <h5>No course roles found</h5>
                                    @if (!string.IsNullOrEmpty(ViewData["CurrentTermFilter"]?.ToString()) || !string.IsNullOrEmpty(ViewData["CurrentProgrammeFilter"]?.ToString()))
                                    {
                                        <p>No results match your current filters.</p>
                                        <a asp-action="Index" class="btn btn-outline-primary">
                                            <i class="fas fa-times me-1"></i>
                                            Clear Filters
                                        </a>
                                    }
                                    else
                                    {
                                        <p>Get started by creating a new course role or uploading a CSV file.</p>
                                        <div class="mt-3">
                                            <a asp-action="Create" class="btn btn-primary me-2">
                                                <i class="fas fa-plus me-1"></i>
                                                Create New
                                            </a>
                                            <a asp-action="Upload" class="btn btn-outline-info">
                                                <i class="fas fa-upload me-1"></i>
                                                Upload CSV
                                            </a>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Enhanced CSS -->
<style>
    .form-label {
        margin-bottom: 0.25rem;
        font-size: 0.875rem;
    }

    .input-group-text {
        border-left: none;
    }

    .form-control:focus + .input-group-append .input-group-text {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }

    .card-header.bg-gradient-primary {
        background: linear-gradient(45deg, #007bff, #0056b3) !important;
    }

    .btn-tool:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 0.25rem;
    }

    .flex-fill {
        min-width: 100px;
    }

    .table th a:hover {
        text-decoration: underline;
    }

    .btn-group .btn {
        border-radius: 0;
    }

    .btn-group .btn:first-child {
        border-top-left-radius: 0.375rem;
        border-bottom-left-radius: 0.375rem;
    }

    .btn-group .btn:last-child {
        border-top-right-radius: 0.375rem;
        border-bottom-right-radius: 0.375rem;
    }

</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl/Cmd + Enter to submit form
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('filterForm').submit();
            }

            // Escape to clear filters
            if (e.key === 'Escape') {
                const clearBtn = document.querySelector('a[asp-action="Index"]:not([asp-route-sortOrder])');
                if (clearBtn) {
                    window.location.href = clearBtn.href;
                }
            }
        });

        // Focus enhancement
        const termInput = document.getElementById('termNameFilter');
        if (termInput) {
            termInput.addEventListener('focus', function() {
                this.parentElement.classList.add('shadow-sm');
            });

            termInput.addEventListener('blur', function() {
                this.parentElement.classList.remove('shadow-sm');
            });
        }

        // Table row hover effect
        const tableRows = document.querySelectorAll('tbody tr');
        tableRows.forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.backgroundColor = '#f8f9fa';
            });

            row.addEventListener('mouseleave', function() {
                this.style.backgroundColor = '';
            });
        });
    });
</script>

